def gh(*args):
    r = subprocess.run(["gh", "api", *args], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return None

def sh(cmd, **kw):
    kw.setdefault("errors", "replace")
    return subprocess.run(cmd, capture_output=True, text=True, **kw)

def rate_ok():
    d = gh("rate_limit")
    if not d:
        return True
    return d["resources"]["core"]["remaining"] > 100

def all_repos(org):
    """Full repo-liste med metadata (paginert)."""
    out, page = [], 1
    while True:
        d = gh(f"orgs/{org}/repos?sort=pushed&per_page=100&page={page}")
        if not d:
            break
        out.extend(d)
        if len(d) < 100:
            break
        page += 1
        if page > 10:
            break
    return out

def select_repos(org, strategy, top):
    repos = all_repos(org)
    if not repos:
        return []
    key = {
        "updated": lambda r: r.get("pushed_at", ""),
        "oldest":  lambda r: r.get("pushed_at", "9999"),
        "big":     lambda r: -(r.get("size", 0)),
        "random":  lambda r: random.random(),
    }.get(strategy, lambda r: r.get("pushed_at", ""))
    repos.sort(key=key, reverse=(strategy != "oldest" and strategy != "random"))
    return [r["name"] for r in repos[:top]]

def dir_size_mb(p):
    r = sh(["du", "-sm", str(p)])
    try:
        return int(r.stdout.split()[0])
    except Exception:
        return 9999

def already_scanned(target):
    """Incrementell: skip hvis .orgxray-scanned med samme HEAD."""
    marker = target / ".orgxray-scanned"
    if not marker.exists():
        return False
    head = sh(["git", "-C", str(target), "rev-parse", "HEAD"]).stdout.strip()
    return marker.read_text().strip() == head

def gitleaks(repo_dir, report_path, history):
    mode = "git" if history else "dir"
    return sh(["timeout", str(GITLEAKS_TIMEOUT), "gitleaks", mode, str(repo_dir),
               "--report-format", "json",
               "--report-path", str(report_path), "--exit-code", "0",
               "--no-banner"])

def clone_repo(org, repo, target, history):
    # core.hooksPath=/dev/null: et ondsinnet repo kan shippe post-checkout-
    # hooks — klone/kjøring må aldri eksekvere mål-kode, uansett nett.
    # LFS/submoduler: ingen --recurse-submodules noen steder, og git-lfs er
    # ikke installert på host eller i orgxray-box — smudge-filters og
    # submodul-hooks kan ikke fyres. Hvis git-lfs noen gang installeres,
    # må GIT_LFS_SKIP_SMUDGE=1 legges til her.
    cmd = ["timeout", str(CLONE_TIMEOUT), "git",
           "-c", "core.hooksPath=/dev/null", "clone", "--quiet"]
    if not history:
        cmd += ["--depth", "1"]
    cmd += [f"https://github.com/{org}/{repo}", str(target)]
    return sh(cmd)

def scan(org, strategy="updated", top=TOPN, history=False, only=None):
    if not rate_ok():
        print(f"[{org}] rate-limit lav — venter 60s"); time.sleep(60)
    org_dir = REPOS / org
    org_dir.mkdir(parents=True, exist_ok=True)
    REPORTS.mkdir(parents=True, exist_ok=True)
    names = list(only) if only else select_repos(org, strategy, top)
    print(f"[{org}] strategi={strategy} repos={len(names)} history={history}")
    results = []
    for repo in names:
        target = org_dir / (f"{repo}-hist" if history else repo)
        if target.exists() and already_scanned(target):
            print(f"  skip (uendret): {repo}"); continue
        if not (target / ".git").exists():
            r = clone_repo(org, repo, target, history)
            if r.returncode != 0:
                print(f"  clone-fail: {repo}"); continue
        elif (target / ".orgxray-scanned").exists():
            # HEAD har bevegd seg — oppdater klona i stedet for re-clone
            upd = sh(["git", "-c", "core.hooksPath=/dev/null",
                      "-C", str(target), "fetch", "--all", "--quiet"]) if history \
                  else sh(["git", "-c", "core.hooksPath=/dev/null",
                           "-C", str(target), "pull", "--ff-only", "--quiet"])
            if upd.returncode != 0:
                print(f"  update-fail: {repo}")
        if not history and dir_size_mb(target) > SIZE_LIMIT_MB:
            print(f"  for stor: {repo}"); continue
        tag = "HIST" if history else "DIR"
        rp = REPORTS / f"{tag}-{org}--{repo}.json"
        gitleaks(target, rp, history)
        fs = deep_scan(target)
        merge_deep(target, rp, fs)
        n = 0
        try:
            n = len(json.loads(rp.read_text()))
        except Exception:
            pass
        if n or fs:
            print(f"  FUNN: {repo} ({n} gitleaks + {len(fs)} deep)")
        head = sh(["git", "-C", str(target), "rev-parse", "HEAD"]).stdout.strip()
        (target / ".orgxray-scanned").write_text(head)
        results.append({"repo": repo, "findings": n})
    return results

def find_repo_dir(org, repo):
    """Finn lokal klone for repo (prøver -hist og vanlig)."""
    base = REPOS / org
    for suffix in ("-hist", ""):
        d = base / (repo + suffix)
        if (d / ".git").exists():
            return d
    return None

def _strip_surface(path):
    """Fjern deep-scan-suffikser som ' [decoded]', ' [binary]', ' [history-diff]'."""
    return re.sub(r"\s*\[[^\]]*\]\s*$", "", path or "")

def _norm_file(f, repo_dir=None):
    """Repo-relativ sti uten surface-suffix — dedupe-nøkkel for 'samme fil'."""
    p = _strip_surface(f.get("File", ""))
    if repo_dir and os.path.isabs(p):
        p = os.path.relpath(p, str(repo_dir))
    return p.lstrip("/")

def secret_in_head(repo_dir, finding):
    """Er secret-verdien fremdeles i HEAD? -> 'LIVE' / 'HIST' / 'UNK'.
    UNK = kan ikke verifiseres (transformert innhold, pseudo-sti) — ikke falsk HIST."""
    secret = finding.get("Secret", "")
    path = finding.get("File", "")
    if not secret or not repo_dir:
        return "HIST"
    base = _strip_surface(path)
    suffix = path[len(base):] if path.startswith(base) else ""
    tag = suffix.strip(" []")
    if not base or base.startswith("[") or base.startswith("gist:"):
        if "commit-message" in path:
            # Meldinger lever i commit-korpuset, ikke i treet
            r = sh(["git", "-C", str(repo_dir), "log", "--all", "--format=%B"])
            return "HIST" if secret in r.stdout else "UNK"
        return "UNK"  # corpus-joined / corpus-stripped — ingen fil å sjekke
    # gitleaks melder absolutt sti; `git show HEAD:` vil ha sti relativ til repo-roten
    rel = os.path.relpath(base, str(repo_dir)) if os.path.isabs(base) else base
    if rel.startswith(".."):
        return "HIST"
    if tag.startswith("history-diff"):
        return "HIST"  # per definisjon funnet i diff-linjer
    if tag:
        # [decoded]/[reversed]/[homoglyph]/[binary] — transformert verdi står
        # sjelden litterært i fila; sjekk om kildefila i det hele tatt finnes i HEAD
        r = sh(["git", "-C", str(repo_dir), "cat-file", "-e", f"HEAD:{rel}"])
        return "UNK" if r.returncode == 0 else "HIST"
    # '--' + literal match i HEAD:path (ingen regex)
    r = sh(["git", "-C", str(repo_dir), "show", f"HEAD:{rel}"])
    if r.returncode != 0:
        return "HIST"  # filen er slettet/mv'et
    return "LIVE" if secret in r.stdout else "HIST"

def _head_secret_block(repo_dir, f):
    """(linje, 5-linjers vindu) rundt secret i HEAD — variabel + lathetskontekst."""
    secret = f.get("Secret", "")
    base = _strip_surface(f.get("File", ""))
    if not secret or not repo_dir or not base or base.startswith("["):
        return "", ""
    rel = os.path.relpath(base, str(repo_dir)) if os.path.isabs(base) else base
    if rel.startswith(".."):
        return "", ""
    r = sh(["git", "-C", str(repo_dir), "show", f"HEAD:{rel}"])
    if r.returncode != 0:
        return "", ""
    lines = r.stdout.splitlines()
    for i, line in enumerate(lines):
        if secret in line:
            # Anker = sammenhengende kommentarfelt over + linjen selv.
            # Stopper ved første ikke-kommentar/ikke-blank — i .env er det
            # forrige KEY=-linje, i kode forrige statement. Ingen linjetall,
            # og ingenting under (TODO under en verdi hører til neste nøkkel).
            ctx = [line]
            j = i - 1
            while j >= 0:
                l = lines[j].strip()
                if l == "" or l.startswith(("#", "//", ";", "/*", "*", "<!--")):
                    ctx.insert(0, lines[j]); j -= 1
                else:
                    break
            return line.strip()[:160], "\n".join(ctx)
    return "", ""

def _hist_var(repo_dir, f):
    """Variabelnavn for HIST-funn: let i de nyeste commitene som rørte fila."""
    secret = f.get("Secret", "")
    base = _strip_surface(f.get("File", ""))
    if not repo_dir or not secret or not base or base.startswith("["):
        return ""
    rel = os.path.relpath(base, str(repo_dir)) if os.path.isabs(base) else base
    if rel.startswith(".."):
        return ""
    commits = sh(["git", "-C", str(repo_dir), "log", "--all",
                  "--format=%H", "-5", "--", rel]).stdout.split()
    for c in commits:
        r = sh(["git", "-C", str(repo_dir), "show", f"{c}:{rel}"])
        if r.returncode != 0:
            continue
        for line in r.stdout.splitlines():
            if secret in line:
                return _var_name(line.strip()[:160])
    return ""

def _var_name(line):
    m = re.match(r"(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=", line or "")
    return m.group(1) if m else ""

def _secret_id(s):
    """Normalisert secret-id for dedupe + cross-file lenking.
    ENKANONISK normaliser for begge motorer: gitleaks- og deep-funns
    Secret-felt går begge gjennom her. Kant-whitespace trimmes og
    indre whitespace-serier kollapses til ett mellomrom — «abc  def»
    og «abc def» matcher, men «abc def» og «abcdef» er fortsatte
    ulike verdier. Anførselstegn ("/') strippes i kantene. Ingen
    per-engine-normalisering: samme input => samme hash."""
    n = re.sub(r"\s+", " ", (s or "").strip()).strip("\"'")
    return hashlib.sha256(n.encode()).hexdigest()[:16] if n else ""

def _rule_base(r):
    """Basis-score for en regel-ID — samme vekting som triage_findings.
    Brukes til å velge primærlabel ved kryss-motor-merge."""
    return 3 if r in SECRET_RULES else 2 if r == "default-creds" \
        else 1 if r else 0

def classify_findings(findings, org, repo, repo_dir=None):
    """Legg til _status (LIVE/HIST) + _dedup-nøkkel."""
    if repo_dir is None:
        repo_dir = find_repo_dir(org, repo)
    seen = {}
    out = []
    for f in findings:
        # Dedupe per (secret, fil): samme hemmelighet i to filer = to lekasjer,
        # samme hemmelighet i samme fil på tvers av commits/revisjoner = én.
        s = f.get("Secret") or ""
        base_dk = (_secret_id(s) + "|" + _norm_file(f, repo_dir)) if s else \
             (f.get("RuleID", "") + "|" + _norm_file(f, repo_dir))
        # Smells: regel i nøkkelen — samme snippet fra to regler = to funn
        dk = (f.get("RuleID", "") + "|" + base_dk) if f.get("_smell") else base_dk
        # Samme (secret,fil) på ulike linjer = separate forekomster, ikke
        # duplikater — da er (hash,fil,linje) nøkkelen, ikke (hash,fil).
        while dk in seen:
            prev = out[seen[dk]]
            sl_f, sl_p = f.get("StartLine"), prev.get("StartLine")
            if sl_f and sl_p and abs(int(sl_f) - int(sl_p)) > 5:
                dk = f"{dk}|L{sl_f}"
                continue
            # Kryss-motor-duplikat: SLÅ SAMMEN, ikke velg. Første rad
            # (gitleaks) eier verifisering; den andre bidrar med metadata.
            # Primærlabel velges på score — ikke på hvilken motor som er
            # base; gitleaks' generiske regler er løsere, så ved uavgjort
            # vinner den andre motorens (vanligvis deep) label.
            fr, pr = f.get("RuleID"), prev.get("RuleID")
            if fr and fr != pr:
                fb, pb = _rule_base(fr), _rule_base(pr)
                if fb > pb or (fb == pb and f.get("_deep")):
                    prev.setdefault("_alt_rules", []).append(pr)
                    prev["RuleID"] = fr
                else:
                    prev.setdefault("_alt_rules", []).append(fr)
            for k in ("StartLine", "Match", "Secret"):
                if not prev.get(k) and f.get(k):
                    prev[k] = f[k]
            eng = "deep" if f.get("_deep") else "gitleaks"
            prev["_engines"] = sorted(set(prev.get("_engines",
                [prev.get("_engine", "gitleaks")]) + [eng]))
            break
        if dk in seen:
            continue
        seen[dk] = len(out)
        f = dict(f)
        if f.get("_smell"):
            # Smells er ikke secrets — ingen HEAD-verifisering, egen status.
            f["_status"] = "SMELL"
        else:
            f["_status"] = secret_in_head(repo_dir, f)
        if f["_status"] == "LIVE":
            line, ctx = _head_secret_block(repo_dir, f)
            f["_var"] = _var_name(line)
            if LAZY_CTX.search(ctx):
                f["_lazy"] = True  # «midlertidig»-kontekst ved secret = lathetsfingeravtrykk
        f["_dedup"] = dk
        f["_sid"] = _secret_id(s)
        # Kryss-motor-eierskap: gitleaks-rader kommer før deep-rader i
        # rapporten, så ved lik (secret,fil) er gitleaks verifikasjons-eier
        # (LIVE/HIST) — deep-radens metadata er merget inn over.
        f["_engine"] = "deep" if f.get("_deep") else "gitleaks"
        f.setdefault("_engines", [f["_engine"]])
        f.setdefault("_rules_rev", RULES_REV)
        out.append(f)
    return _assemble_components(out, repo_dir)

# ---------- multipart/component rules (betterleaks `components`) ----------
# En parent-funn kan kreve at en nabokomponent er til stede før verdien
# er meningsfull. Komponentene eksponeres som f["_components"][cid]
# = {"secret": <verdi>, "via": <kilde>} — samme tilgangsmønster som
# components["id"].secret. Manglende PÅKREVD komponent settes i
# f["_component_gap"] og demper quality til 'low' (teknisk ubekreftelig).
def _component_needs(f):
    """{component_id: [(kind, arg), …]} — første match vinner.
    kind 'file-re': regex på filnavnet (group 1 = komponent-verdien)
    kind 'nearby':  (compiled-regex, span) — fil-linjer rundt funnet."""
    path = f.get("File", "")
    needs = {}
    if f.get("RuleID") == "private-key" and re.search(r"\.p8$", path, re.I):
        # Apple .p8 (APNs/App Store Connect): .p8-endelsen ER Apple-formatet.
        # Nøkkelen alene er uverifiserbar — key_id må ligge i filnavnet
        # (AuthKey_<KEYID>.p8) eller som key_id/kid/issuer_id i samme fil.
        needs["apple-key-id"] = [
            ("file-re", r"AuthKey_([A-Z0-9]{10})\.p8"),
            ("nearby", (re.compile(
                r"(?i)(?:key[_-]?id|kid|issuer[_-]?id)\s*[:=]\s*[\"']?([A-Za-z0-9-]{8,})"),
             200)),
        ]
    return needs

def _assemble_components(findings, repo_dir):
    for f in findings:
        needs = _component_needs(f)
        if not needs:
            continue
        path = f.get("File", "")
        if repo_dir and not os.path.exists(path):
            cand = os.path.join(repo_dir, _norm_file(f, repo_dir))
            if os.path.exists(cand):
                path = cand
        comps, gaps = {}, []
        for cid, descriptors in needs.items():
            hit = None
            for kind, arg in descriptors:
                if kind == "file-re":
                    m = re.search(arg, os.path.basename(path))
                    if m:
                        hit = {"secret": next((g for g in m.groups() if g),
                                              m.group(0)), "via": "filename"}
                        break
                elif kind == "nearby":
                    rx, span = arg
                    for line in _file_lines(path, f.get("StartLine") or 1, span):
                        m = rx.search(line)
                        if m:
                            hit = {"secret": next((g for g in m.groups() if g),
                                                  m.group(0)), "via": "nearby"}
                            break
                    if hit:
                        break
            if hit:
                comps[cid] = hit
            else:
                gaps.append(cid)
        if comps:
            f["_components"] = comps
        if gaps:
            f["_component_gap"] = gaps
    return findings

def jwt_role(secret):
    """Returnerer 'role'-claim fra JWT-payload, eller None."""
    try:
        import base64
        p = secret.split(".")[1]
        p += "=" * (-len(p) % 4)
        return json.loads(base64.urlsafe_b64decode(p)).get("role")
    except Exception:
        return None

JUNK_VALUE = re.compile(
    r"(your[-_ ]?(api[-_ ]?)?(key|secret|token)|changeme|change[-_ ]?me|"
    r"example[-_ ]?(key|secret|token|api)|xxx{2,}|\*{3,}|redacted|placeholder|"
    r"insert[-_ ]?(key|secret|token)|localhost|127\.0\.0\.1|0\.0\.0\.0|"
    r"apps\.googleusercontent\.com|example\.(com|org|net)|"
    r"<[^>]{2,}>|\$\{[^}]+\})", re.I)

DSN_PLACEHOLDER = re.compile(
    r"://[^/\s:]+:(?:user|username|password|passwd|pass|admin|test|"
    r"changeme|secret|your[_-]?\w*|xxx+|<[^>]*>|\$\{[^}]*\})[^@/\s]*@",
    re.I)

def value_junk(f):
    """True hvis selve hemmelighetsverdien er placeholder / public-by-design.
    Kaster ikke ut formatter som bare *ligner* — kaster ut det som er åpenbart ikke-ekte."""
    import urllib.parse
    s = f.get("Secret") or f.get("Match") or ""
    s = urllib.parse.unquote(s)  # URL-enkodede passord (%40, %23) før sjekk
    if re.match(r"age1[02-9ac-hj-np-z]{20,}", s.strip()):
        return True  # age public key (agenix) — public by design
    if re.match(r"^[a-z0-9][a-z0-9._-]*-\d{4}-\d{2}-\d{2}$", s.strip()):
        return True  # dato-versjonsstrenger som «oidc-federation-2026-04-01» er API-flags, ikke secrets
    if JUNK_VALUE.search(s) or DSN_PLACEHOLDER.search(s):
        return True
    ent = f.get("Entropy")
    if isinstance(ent, (int, float)) and ent < 2.5:
        return True
    return False

# --- public-vs-private bevis (teknikk portert fra skylos secret_shapes) ---
# «Bevis mot» fremfor «mønster for»: disse er kontekst som viser at verdien
# er public by design. Demper KUN generic-regler — provider-formater
# (SECRET_RULES) dempes aldri, samme prinsipp som upstream.
_SLUG_PART_RE = re.compile(
    r"(?:[A-Z]?[a-z]+){1,3}|[A-Z]{1,6}|[0-9]{1,8}|[A-Za-z]{1,3}[0-9]{1,4}|[0-9]{1,4}[A-Za-z]{1,3}")
_EVM_ADDR_RE = re.compile(r"0x[0-9a-fA-F]{40}")
_SSH_PUB_RE = re.compile(
    r"(?:ssh-(?:rsa|dss|ed25519)|ecdsa-sha2-nistp(?:256|384|521)"
    r"|sk-(?:ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com)"
    r"\s+(?P<blob>AAAA[A-Za-z0-9+/]+={0,3})")
_PUBLIC_DOC_HOSTS = frozenset((
    "docs.google.com", "drive.google.com", "sheets.google.com",
    "slides.google.com", "forms.gle", "forms.office.com", "youtube.com",
    "www.youtube.com", "youtu.be", "figma.com", "www.figma.com",
    "notion.so", "www.notion.so"))
_URL_RE = re.compile(
    r"https?://(?P<host>[A-Za-z0-9.-]+)(?::\d+)?(?P<path>/[^\s'\"`<>?#]*)?")
_IDENT_LBL_RE = re.compile(
    r"(?P<label>[A-Za-z][A-Za-z0-9_]*)\s*[\"']?\s*[:=]\s*[\"']?\s*$")
_IDENT_SUFFIXES = ("id", "ids", "uuid", "guid", "identifier")
_IDENT_CRED_WORDS = ("session", "secret", "token", "key", "pass", "auth", "cred")
_JWK_MEMBER_RE = re.compile(
    r"""^\s*["']?(?:x|y|n|e)["']?\s*:\s*["'](?P<value>[A-Za-z0-9_-]+)["']""")
_JWK_MARKER_RE = re.compile(r"""["']?(?:kty|crv)["']?\s*:""")
_FILE_CTX_CACHE = {}

def _file_lines(path, start, span=10):
    """Begrenset fil-lesing for JWK/PEM-kontekst — én fil per funn, max ~21 linjer."""
    try:
        key = (path, start)
        if key in _FILE_CTX_CACHE:
            return _FILE_CTX_CACHE[key]
        with open(path, "r", errors="replace") as fh:
            lines = fh.readlines()
        lo = max(0, start - 1 - span)
        hi = min(len(lines), start + span)
        out = lines[lo:hi]
        if len(_FILE_CTX_CACHE) > 4000:
            _FILE_CTX_CACHE.clear()
        _FILE_CTX_CACHE[key] = out
        return out
    except Exception:
        return []

_PEM_PUBLIC_TYPES = frozenset((
    "PUBLIC KEY", "RSA PUBLIC KEY", "CERTIFICATE", "TRUSTED CERTIFICATE",
    "CERTIFICATE REQUEST", "NEW CERTIFICATE REQUEST", "X509 CRL",
    "PGP PUBLIC KEY BLOCK", "SSH2 PUBLIC KEY"))

def _public_pem_near(path, start):
    """Er linje `start` inne i en PUBLIC KEY / CERTIFICATE-PEM-blokk?
    State-maskin: BEGIN type → body → END. Privat nøkkel = ikke public."""
    try:
        in_block = None  # None | "public" | "private" | "other"
        with open(path, "r", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i >= (start or 1) - 1:
                    return in_block == "public"
                m = re.search(r"-----BEGIN ([A-Z0-9 ]+)-----", line)
                if m:
                    t = m.group(1)
                    in_block = ("private" if "PRIVATE" in t
                                else "public" if t in _PEM_PUBLIC_TYPES
                                else "other")
                    continue
                if in_block and re.search(r"-----END [A-Z0-9 ]+-----", line):
                    in_block = None
    except Exception:
        return False
    return False

def public_evidence(f):
    """True hvis public-by-design-bevis finnes. Returnerer grunnen (for debug)."""
    rule = f.get("RuleID", "")
    if rule in SECRET_RULES:
        return None  # provider-formater dempes aldri
    secret = (f.get("Secret") or "").strip()
    match = f.get("Match") or ""
    path = f.get("File", "")
    if not secret:
        return None
    s = secret.strip("'\"`")
    # env/interpolasjon — referanse, ikke verdi
    if re.fullmatch(r"(\$\{\{[^}]+\}\}|\$\{[^}]+\}|\$[A-Za-z_][A-Za-z0-9_]*|"
                    r"%[A-Za-z_][A-Za-z0-9_]*%|\{\{[^}]+\}\})", s):
        return "reference-to-secret-elsewhere"
    # getenv/process.env-kall uten literal-verdi
    if re.fullmatch(r"(?:getenv|environ\.get|getenvb)\(\s*[\"'][A-Z][A-Z0-9_]*[\"']\s*\)", s) \
            or s.startswith(("process.env.", "os.environ", "import.meta.env.")):
        return "indirect-env-read"
    # character table: hver char én gang = encoding-alfabet
    if len(s) >= 32 and len(set(s)) == len(s):
        return "character-table"
    # EVM-adresse: public by design (privat nøkkel er 64 hex)
    if _EVM_ADDR_RE.fullmatch(s):
        return "evm-address"
    # word slug: build-guide-v2 / TEAM-001-v2
    parts = [p for p in re.split(r"[-_]+", s) if p]
    if len(parts) >= 3 and all(len(p) <= 16 and _SLUG_PART_RE.fullmatch(p)
                               for p in parts):
        return "word-slug"
    # prosa: 3+ ord med mellomrom — kun generic-regler (allerede gated over)
    if len(s.split()) >= 3 and " " in s:
        return "prose-value"
    # intern cluster-URL uten credential-materiale: scheme://vert:port/sti
    # med INGEN userinfo (@) — f.eks. redis://redis:6379/0 i k8s-manifester.
    # En URL uten @ bærer ikke noe hemmelighetsmateriale i seg selv.
    if re.fullmatch(r"[a-z][a-z0-9+.-]*://[^/@\s]+", s):
        return "internal-url-no-credential"
    # reCAPTCHA site-key: 6L…-format, men site-nøkler er public by design.
    # Hemmelig nøkkel heter *_SECRET*_KEY — den dempes aldri.
    if re.fullmatch(r"6L[\w-]{30,}", s) and \
            not re.search(r"secret", (f.get("_var") or "") + match, re.I) and \
            (re.search(r"sitekey|site_key|SITE_KEY|sitekey", match + (f.get("_var") or ""), re.I)
             or re.search(r"NEXT_PUBLIC|VITE_", f.get("_var") or "", re.I)
             or re.search(r"\.(jsx?|tsx?|html?)$", path, re.I)):
        return "recaptcha-site-key"
    # SSH public key-blob på samme linje
    for m in _SSH_PUB_RE.finditer(match):
        if s in m.group("blob") or m.group("blob").startswith(s[:16]):
            return "ssh-public-key-blob"
    # token som path-segment i public doc/share-URL
    for m in _URL_RE.finditer(match):
        if (m.group("host") or "").lower() in _PUBLIC_DOC_HOSTS and \
                m.group("path") and s in m.group("path"):
            return "public-document-url"
    # verdi = key-navnet i annen case (ADMIN_PASSWORD: "adminPassword")
    pre = match[:match.find(s)] if s in match else match
    lm = _IDENT_LBL_RE.search(pre)
    if lm:
        label = lm.group("label")
        low = label.lower()
        if low.endswith(_IDENT_SUFFIXES) and not any(
                w in low for w in _IDENT_CRED_WORDS):
            return "identifier-label"
        # names_its_key: normalisert verdi == normalisert key-navn
        norm_v = re.sub(r"[^a-z0-9]", "", s.lower())
        norm_k = re.sub(r"[^a-z0-9]", "", label.lower().rsplit(".", 1)[-1])
        if len(norm_v) >= 8 and norm_v == norm_k:
            return "value-names-its-key"
    # JWK public members: "x"/"n"/"e" med kty/crv i nærheten (fil-kontekst)
    jm = _JWK_MEMBER_RE.match(match.strip())
    if jm and jm.group("value") == s and path.endswith((".json", ".jwk")):
        ctx = _file_lines(path, f.get("StartLine") or 0, 8)
        if any(_JWK_MARKER_RE.search(l) for l in ctx):
            return "jwk-public-member"
    # public PEM-blokk (cert/public key) — fil-kontekst
    if path.lower().endswith((".pem", ".crt", ".cer", ".key")) and \
            re.fullmatch(r"[A-Za-z0-9+/=\s]{40,}", s):
        if _public_pem_near(path, f.get("StartLine") or 0):
            return "public-pem-block"
    return None

