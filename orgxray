def _bpe():
    """cl100k_base tokenizer (betterleaks' tokenizer). Lazy — vocab
    lastes én gang og caches av tiktoken. Feil -> None (filter av)."""
    global _BPE_ENC
    if _BPE_ENC is None:
        try:
            import tiktoken
            _BPE_ENC = tiktoken.get_encoding("cl100k_base")
        except Exception as e:
            _BPE_ENC = False
            print(f"[orgxray] bpe-tokenizer utilgjengelig "
                  f"({e.__class__.__name__}: {e}) — "
                  "token-efficiency-filter er AV", file=sys.stderr)
    return _BPE_ENC or None

