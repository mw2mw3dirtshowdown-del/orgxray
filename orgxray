            fs = gist_all_revisions(login, g)
            if fs:
                print(f"  GIST-FUNN: {login} {g.get('description') or g['id']} ({len(fs)})")
                for f in fs[:3]:
                    print(f"    [{f['RuleID']}] {f['File']} {f['Secret'][:50]}")
                total += len(fs)
                gist_all.extend(fs)
        if gist_all:
            persist_gist_report(gp, gist_all)
    print(f"[self] {login}: totalt {total} funn")

ORG_DOMAINS = {
    "anthropics": ["anthropic.com"],
    "supabase": ["supabase.io", "supabase.com"],
    "PostHog": ["posthog.com"],
    "netlify": ["netlify.com"],
