def triage_findings(findings):
    """Severity-score + FP-filter + quality. Returnerer sortert liste."""
    out = []
    for f in findings:
        if f.get("_smell"):
            # Tier-1 over terskelen (synlig i triage), tier-2 under (audit-only
            # i JSON inntil kalibrert). todo-secret er ren kontekst: score 0.
            rule = f.get("RuleID", "")
            score = 0 if rule == "smell-todo-secret" else \
                    (2 if f.get("_smell_tier") == 1 else 1)
            if score >= 2:
                out.append({**f, "_score": score, "_quality": "smell"})
            continue
        rule = f.get("RuleID", "")
        path = f.get("File", "")
        # Én score-eier: høyeste basis-score blant alle regel-ID-er funnet
        # for denne (secret,fil) — gitleaks og deep kan navngi samme lek
        # forskjellig, og vi scorer det beste av dem, ikke første.
        score = max(
            (3 if r in SECRET_RULES else 2 if r == "default-creds"
             else 1 if r else 0)
            for r in [rule] + list(f.get("_alt_rules", [])))
        if FP_PATH.search(path):
            score -= 2
        # Signerings-/session-nøkler gir sesjonsforfalskning — ranger over OAuth/client secrets
        ctx = " ".join([f.get("Match") or "", f.get("_var") or "", path])
        if score < 5 and re.search(
                r"(JWT|SESSION|SIGNING|COOKIE|TOKEN)[_-]?(SECRET|KEY|SALT)|"
                r"(SECRET|KEY)[_-]?(FOR|_)(JWT|SESSION)", ctx, re.I):
            score += 1  # én gang, cappet — signeringsnøkkel rangerer ikke dobbelttelt
        if score < 5 and f.get("_lazy"):
            score += 1  # TODO/temp/workaround ved secret — sannsynlig visst-hastverk
        q = finding_quality(f)
        if q == "low":
            score -= 2
        elif q == "high":
            score += 1
        f = {**f, "_quality": q}
        if score >= 2:
            out.append({**f, "_score": score})
    return sorted(out, key=lambda x: -x["_score"])

def triage(src):
