        rows += (f"<tr><td>{esc(repo)}</td><td>{esc(f['RuleID'])}</td>"
                 f"<td>{esc(f['File'])}</td><td>{esc(f.get('Commit','')[:10])}</td>"
                 f"<td>{esc(f.get('Date','')[:10])}</td>"
                 f"<td style='color:{color};font-weight:bold'>{st}</td></tr>\n")
    html = f"""<!doctype html><html><head><meta charset="utf-8">
<title>orgxray rapport — {esc(org)}</title>
<style>body{{font-family:system-ui;max-width:1100px;margin:2rem auto;padding:0 1rem}}
