_NO_MORPHEMES = None
def _morphemes():
    global _NO_MORPHEMES
    if _NO_MORPHEMES is None:
        try:
            import zlib, base64
            _NO_MORPHEMES = frozenset(zlib.decompress(
                base64.b85decode(re.sub(r"\s+", "",
                    _NO_MORPHEMES_B85))).decode().split())
        except Exception:
            _NO_MORPHEMES = frozenset()
    return _NO_MORPHEMES

_ALPHA_NO_RE = re.compile(r"[A-Za-zæøåÆØÅ]{6,}")
# Tak på lengden DP-ene (_compound_wordlike, _passphrase_like) får se:
# legitimt sammensatte norske ord/passfraser er korte; lengre
# alfabetiske blobs er tokens/certifikat-data som skal avgjøres av
# TE-laget, ikke flis mot ordboka. Bounding holder filteret
# lineært og beskytter mot patologiske inputs.
_COMPOUND_MAX_RUN = 45
_PASSPHRASE_MAX_RUN = 128
def _fold_no(w):
    return w.lower().replace("æ","ae").replace("ø","o").replace("å","a")

def _compound_wordlike(s):
    """True hvis en alfabetisk kjernedelen (>=6 tegn) i s kan flises
    fullstendig av norske morfemer — dvs. er en sammensetning eller et
    sjeldent ord bygd av kjente deler. DP over kjernedelen, segmenter
    2-15 tegn. Krever HEL dekning: tilfeldige strenger fliser aldri
    seg helt inn i ordboka."""
    morph = _morphemes()
    if not morph:
        return False
    for run in _ALPHA_NO_RE.findall(s):
        w = _fold_no(run)
        n = len(w)
        # rene ordbokord («secret», «token» i provider-prefikser)
        # er ikke compounds — de tilhører _wordlike/TE-laget
        if n < 6 or n > _COMPOUND_MAX_RUN or w in _COMMON_WORDS:
            continue
        # dp[i] = minst antall morfemer som fliser w[:i]; krever >=2
        # (ellers teller ett vilkårlig morfem-treff som «compound»)
        dp = [99] * (n + 1)
        dp[0] = 0
        for i in range(n):
            if dp[i] == 99:
                continue
            for L in range(2, min(15, n - i) + 1):
                if w[i:i+L] in morph and dp[i] + 1 < dp[i + L]:
                    dp[i + L] = dp[i] + 1
        if 2 <= dp[n] <= 6:
            return True
    return False

_EN_WORDS = None
def _en_words():
    global _EN_WORDS
    if _EN_WORDS is None:
        try:
            import zlib, base64
            _EN_WORDS = frozenset(zlib.decompress(
                base64.b85decode(re.sub(r"\s+", "",
                    _EN_WORDS_B85))).decode().split())
        except Exception:
            _EN_WORDS = frozenset()
    return _EN_WORDS

# ordbokord for passfrase-tiling: vanlige ord (EN+NO), ikke morfemer.
# Et ord må vaere >=3 tegn for a unngaa «a»/«i»-stoy i DP-en.
_DICT_WORDS = None
def _dict_words():
    global _DICT_WORDS
    if _DICT_WORDS is None:
        _DICT_WORDS = frozenset(
            w for w in (_COMMON_WORDS | _en_words()) if len(w) >= 3)
    return _DICT_WORDS

def _passphrase_like(s):
    """True hvis en alfabetisk kjernedel (>=6 tegn, <=128) flises
    fullstendig av >=3 HELLE ordbokord — dvs. en bevisst
    ordbok-passfrase («correcthorsebatterystaple», «sommerfisketur»).
    Slike er svake, men de ER secrets: dempes til low, fkastes
    aldri. Provider-tokener har aldri 3+ sammenhengende
    ordboksegmenter, saa de slipper ikke gjennom her."""
    words = _dict_words()
    if not words:
        return False
    for run in _ALPHA_NO_RE.findall(s):
        w = _fold_no(run)
        n = len(w)
        if n < 6 or n > _PASSPHRASE_MAX_RUN or w in words:
            continue
        # best[i] = maks antall ordbokord som fliser w[:i];
        # 0 = ikke naadd (posisjon 0 er alltid start)
        best = [0] * (n + 1)
        for i in range(n):
            if i > 0 and best[i] == 0:
                continue
            for L in range(3, min(20, n - i) + 1):
                seg = w[i:i+L]
                if seg in words:
                    cand = best[i] + 1
                    if cand > best[i + L]:
                        best[i + L] = cand
        if best[n] >= 3:
            return True
    return False

_COMMON_WORDS = _COMMON_WORDS_EN | _COMMON_WORDS_NO
_WORD_RE = re.compile(r"[A-Za-z]{3,}")

def _has_common_word(s, minlen):
    # TO semantikker for «vanlig ord» i modulen: her = delstreng-
    # treff (minst ett ordbokord som _)ord_) brukt bare til aa velge
    # TE-terskel for korte strenger; i _wordlike/_passphrase_like =
    # dekning/hel-flis. Ryddes i en senere pass.
    return any(w.lower() in _COMMON_WORDS
               for w in _WORD_RE.findall(s) if len(w) >= minlen)

def _wordlike(s):
    """Strukturell erstatning for delstreng-ordfilter: fyre KUN når
    ordbokstreff dekker dominerende andel av alfabetisk innhold.
    «secret» som bi-innslag i et token (sb_secret_…, sk_live_…)
    gir lav dekning -> ikke wordlike. «sommer2024», «password123»
    gir ~100 % -> wordlike. Ingen prefiksliste à vedlikeholde."""
    words = _WORD_RE.findall(s)
    if not words:
        return False
    total = sum(len(w) for w in words)
    covered = sum(len(w) for w in words if w.lower() in _COMMON_WORDS)
    return covered / total >= 0.6

def fails_token_efficiency(secret):
    """Betterleaks' token-efficiency filter (Rare Not Random):
    secrets er *sjelden* tekst, ikke bare høy entropi. BPE-brytning
    måler hvor lite strengen ligner naturlig språk.
    Returnerer True = forkast (filter FEILER strengen).
    https://www.aikido.dev/blog/token-efficiency-secrets-scan"""
    enc = _bpe()
    if enc is None:
        return False  # tokenizer utilgjengelig -> filter av, ikke kast
    analyzed = re.sub(r"[\r\n]+", "", secret) \
        if len(secret) < 20 and re.search(r"[\r\n]", secret) else secret
    if not analyzed:
        return False
    n_tokens = len(enc.encode(analyzed))
    if n_tokens == 0:
        return False
    if _wordlike(analyzed):
        return True  # dominerende andel ordbok = prosa
    if _passphrase_like(analyzed) or _compound_wordlike(analyzed):
        return False  # ordbok-passfrase/sammensetning: ekte secret,
                      # dempes til low i finding_quality — aldri forkastes
    threshold = 2.5
    if len(analyzed) < 12:
        threshold = 2.1 if _has_common_word(analyzed, 3) else 2.5
    return len(analyzed) / n_tokens >= threshold

def finding_quality(f):
    """Verdi-estimat: 'high' | 'low' | 'medium'. Path- og innholds-basert."""
    path = f.get("File", "")
    if f.get("RuleID") == "jwt" and jwt_role(f.get("Secret", "")) == "anon":
        return "low"  # Supabase/Firebase anon-keys er public by design
    if value_junk(f):
        return "low"  # placeholder-verdi eller public-by-design (Google client-ID)
    # Publishable/frontend-keys er public by design — egen demper, adskilt
    # fra sb_secret_-lignende hemmeligheter som beholdes i high.
    if re.search(r"PUBLISHABLE", f.get("_var") or "", re.I) or \
            re.match(r"(pk_(live|test)_|sb_publishable_|phc_|pk\.)",
                     (f.get("Secret") or "").strip(), re.I):
        return "low"
    if public_evidence(f):
        return "low"  # public-by-design bevis (skylos-port: slug, EVM, PEM, JWK…)
    if f.get("_component_gap"):
        return "low"  # multipart: påkrevd komponent mangler — uverifiserbar
    # BPE token-efficiency: generiske kandidater som ligner naturlig
    # språk forkastes — provider-formater (SECRET_RULES) unntatt.
    if f.get("RuleID") not in SECRET_RULES and \
            fails_token_efficiency((f.get("Secret") or "").strip()):
        return "low"
    # Ordbok-passfrase (>=3 hele ord) og norske sammensetninger
    # (fjellby, bergensregnet): de vanligste norske passordformene —
    # bevisste valg, men svake. Demotes til low, aldri forkastes
    # (se _passphrase_like / _compound_wordlike).
    if f.get("RuleID") not in SECRET_RULES and \
            (_passphrase_like((f.get("Secret") or "").strip()) or
             _compound_wordlike((f.get("Secret") or "").strip())):
        return "low"
    if DEV_SECRET_PATH.search(path):
        return "low"  # Rails dev/test-grade hemmeligheter i personlige prosjekter
    if FP_PATH.search(path):
        return "low"
    if HIGH_VALUE_PATH.search(path):
        return "high"
    if LOW_VALUE_PATH.search(path):
        return "low"
    return "medium"

