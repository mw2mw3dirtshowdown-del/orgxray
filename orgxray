# (HEAD-only), men sorteres nederst og verifiseres ikke som default.
# 3 år som utgangspunkt — norsk offentlig sektor har dormant repoer
# med levende tjenester, så 2 år er for aggressivt for målkorpuset.
STALE_DAYS = int(os.environ.get("ORGXRAY_STALE_DAYS", "1095"))

def _stale(ts):
    """Repo er stale hvis siste commit er eldre enn STALE_DAYS."""
    return bool(ts) and (time.time() - ts) / 86400 > STALE_DAYS

def _rules_rev():
    """Versjon på deteksjonskunnskapen: kun rules/*.md — koden har sin
    egen versjon, og blanding ville maskere om *reglene* faktisk endret
    seg. Skrives på hvert funn (_rules_rev)."""
    h = hashlib.sha256()
    try:
        for p in sorted(RULES.glob("*.md")):
            h.update(p.name.encode()); h.update(p.read_bytes())
    except Exception:
        pass
    return h.hexdigest()[:12]
RULES_REV = _rules_rev()

def _file_sha(path):
    try:
        return hashlib.sha256(Path(path).read_bytes()).hexdigest()[:16]
    except Exception:
        return None

_BUILD_STAMP = None
def _build_stamp():
    """Stempel på DEN FILEN som faktisk kjører — sha256(__file__)[:12]
    + mtime. Brukes ved skannestart og i runs.jsonl, slik at en stale
    kopi (f.eks. gammelt binær i container) er synlig i loggen i
    stedet for å se helt normal ut."""
    global _BUILD_STAMP
    if _BUILD_STAMP is None:
        # ORGXRAY_BUILD_STAMP settes av orgxray-sandbox på VERTEN før
        # containerstart — der er hele repoet synlig, her er bare fila
        # bind-mountet og git-metadata borte. Samme fil = samme hash,
        # så stemplene er sammenlignbare.
        env_stamp = os.environ.get("ORGXRAY_BUILD_STAMP")
        if env_stamp:
            _BUILD_STAMP = env_stamp
            return _BUILD_STAMP
        try:
            p = Path(__file__).resolve()
            h = hashlib.sha256(p.read_bytes()).hexdigest()[:12]
            mt = time.strftime("%Y-%m-%d", time.localtime(p.stat().st_mtime))
            stamp = f"{h}@{mt}"
            # git-proveniens hvis fila lever i et repo: commit + dirty-
            # flagg. Ucommittede endringer gir unik hash, men ser
            # ikke annerledes ut enn en committet fil uten denne.
            try:
                import subprocess
                d = str(p.parent)
                rev = subprocess.run(
                    ["git", "-C", d, "rev-parse", "--short", "HEAD"],
                    capture_output=True, text=True, timeout=5)
                if rev.returncode == 0:
                    commit = rev.stdout.strip()
                    dirty = subprocess.run(
                        ["git", "-C", d, "status", "--porcelain", "--",
                         str(p)],
                        capture_output=True, text=True, timeout=5)
                    stamp += f"+{commit}" + \
                        ("+dirty" if dirty.stdout.strip() else "")
            except Exception:
                pass
            _BUILD_STAMP = stamp
        except Exception:
            _BUILD_STAMP = "unknown"
    return _BUILD_STAMP

def _log_run(entry):
    """Append kjøringsmanifest til runs.jsonl — hva som var i scope denne
    kjøringen (repos-file, target-liste, --days)."""
    try:
        entry = dict(entry)
        entry["build"] = _build_stamp()
        entry["ts"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with open(BASE / "runs.jsonl", "a") as fh:
            fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except Exception:
        pass
