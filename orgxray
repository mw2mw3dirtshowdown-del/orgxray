def watch(orgs=None, strategy="updated", top=TOPN, init_only=False):
    """Rescan kun repos som har fått nye commits siden sist (pushed_at > scan-tid).
    --init: skriv baseline-state uten scanning (alle repos markeres som sett)."""
    orgs = orgs or KNOWN_ORGS
    state_file = BASE / "last-watch.json"
    state = {}
    if state_file.exists():
        try: state = json.loads(state_file.read_text())
        except Exception: state = {}
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    if init_only:
        for org in orgs:
            for r in all_repos(org):
                state[f"{org}/{r['name']}"] = r.get("pushed_at", now)
            print(f"[{org}] baseline registrert")
        state_file.write_text(json.dumps(state))
        print(f"baseline skrevet -> {state_file} ({len(state)} repos)")
        return
    new_state = {}
    for org in orgs:
        repos = all_repos(org)
        if not repos:
            continue
        changed = []
        for r in repos:
            pushed = r.get("pushed_at", "")
            last = state.get(f"{org}/{r['name']}", "")
            if pushed > last:
                changed.append(r["name"])
        if not changed:
            continue
        print(f"[{org}] {len(changed)} repos endret — scanner top {min(len(changed), top)}")
        # scann bare endrede, nyeste først
        changed.sort(key=lambda n: next((r["pushed_at"] for r in repos if r["name"]==n), ""), reverse=True)
        scan(org, strategy, top=min(top, len(changed)), only=changed[:top])
        for r in repos:
            new_state[f"{org}/{r['name']}"] = r.get("pushed_at", now)
        for n in changed:
            new_state[f"{org}/{n}"] = now
    # behold state for repos som ikke kom i denne kjøringa
    for k, v in state.items():
        new_state.setdefault(k, v)
    state_file.write_text(json.dumps(new_state))
    print("watch fullført — state oppdatert")

