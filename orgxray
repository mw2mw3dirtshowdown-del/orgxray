def committers(org):
    """Commit-forfattere i orgens repos -> GitHub-logins (fallback når members skjult).
    Bruker gh api commits (forfatter-login + email-domene)."""
    org_dir = REPOS / org
    repos = [d.name for d in org_dir.iterdir() if (d / ".git").exists()] if org_dir.exists() else []
    if not repos:
        print(f"[{org}] ingen lokale repos — kjør scan først"); return
    stats = {}
    for repo in repos:
        data = gh(f"repos/{org}/{repo}/commits?per_page=100")
        if not isinstance(data, list):
            continue
        for c in data:
            a = c.get("author") or {}
            login = a.get("login")
            if not login or login.endswith("[bot]") or a.get("type") == "Bot":
                continue
            email = ((c.get("commit") or {}).get("author") or {}).get("email", "")
            domain = email.split("@")[-1].lower() if "@" in email else ""
            e = stats.setdefault(login, {"login": login, "commits": 0,
                                         "repos": set(), "domains": Counter()})
            e["commits"] += 1
            e["repos"].add(repo)
            if domain:
                e["domains"][domain] += 1
    rows = []
    emp_domains = set(ORG_DOMAINS.get(org, []))
    for e in stats.values():
        top_domain = e["domains"].most_common(1)[0][0] if e["domains"] else ""
        e["employee"] = top_domain in emp_domains
        e["repos"] = sorted(e["repos"])
        e["domains"] = dict(e["domains"].most_common(3))
        rows.append(e)
    rows.sort(key=lambda x: (-x["employee"], -x["commits"]))
    PEOPLE.mkdir(parents=True, exist_ok=True)
    out = PEOPLE / f"{org}-committers.json"
    out.write_text(json.dumps(rows, indent=2))
    emp = [r for r in rows if r["employee"]]
    print(f"[{org}] {len(rows)} commit-logins, {len(emp)} med org-domene -> {out}")
    for r in emp[:15]:
        print(f"  EMP {r['login']} commits={r['commits']} repos={len(r['repos'])} @{list(r['domains'])[0]}")

def committer_logins(org):
    """Logins fra committers-json: først org-domene, så resten."""
    f = PEOPLE / f"{org}-committers.json"
    if not f.exists():
        return []
    rows = json.loads(f.read_text())
    return [r["login"] for r in rows]

def members(org, top=30, do_gists=True, do_deep=True, logins=None,
            rescan=False, history=False, repos_file=None):
    """Scan org-medlemmers/commit-forfatteres personlige repos + gists.
    logins=None -> public members API; liste -> committers-fallback."""
    base = REPOS / f"{org}-members"
    base.mkdir(parents=True, exist_ok=True)
    REPORTS.mkdir(parents=True, exist_ok=True)
    if logins is None:
        mem = gh(f"orgs/{org}/members?per_page=100")
        if not isinstance(mem, list) or not mem:
            print(f"[{org}] ingen offentlige medlemmer (medlemskap kan være skjult)")
            return
        scored = []
        for m in mem[:100]:
            login = m["login"]
            repos = gh(f"users/{login}/repos?per_page=100")
            scored.append((len(repos) if isinstance(repos, list) else 0, login))
        scored.sort(reverse=True)
        targets = [l for _, l in scored[:top]]
        print(f"[{org}] {len(mem)} offentlige medlemmer -> scanner topp {len(targets)}")
    else:
        targets = logins[:top]
        print(f"[{org}] committers-liste -> scanner {len(targets)} logins")
    wanted = _name_list(repos_file) if repos_file else None
    total = 0
    for login in targets:
        mdir = base / login
        mdir.mkdir(exist_ok=True)
        repos = gh(f"users/{login}/repos?per_page=100") or []
        if wanted is not None:
            repos = [r for r in repos
                     if any(l == r.get("name") or l.endswith("/" + str(r.get("name")))
                            for l in wanted)]
        for repo in repos:
            if repo.get("fork"):
                continue
            name = repo["name"]
            target = mdir / name
            t0 = time.time()
            # Stale-tier: repo med ingen pushes >STALE_DAYS klones
            # grunt og skannes HEAD-only selv med --history — et dødt
            # repo sparer full-historikk-klon og unshallow-fetch.
            # pushed_at er API-proxyen; nøyaktig commit-ts sjekkes
            # likevel i shortlisten via _repo_ts.
            pushed_ts = 0
            try:
                from datetime import datetime, timezone
                pushed_ts = int(datetime.fromisoformat(
                    (repo.get("pushed_at") or "").replace("Z", "+00:00"))
                    .timestamp())
            except Exception:
                pushed_ts = 0
            stale_repo = _stale(pushed_ts)
            eff_history = history and not stale_repo
            if not (target / ".git").exists():
                cmd = ["timeout", "300", "git",
                       "-c", "core.hooksPath=/dev/null", "clone", "--quiet"]
                if not eff_history:
                    cmd += ["--depth", "1"]
                cmd += [repo["clone_url"], str(target)]
                r = sh(cmd)
                if r.returncode != 0:
                    continue
            elif eff_history:
                # 已有浅克隆：补全历史，避免重下
                shallow = sh(["git", "-C", str(target), "rev-parse",
                              "--is-shallow-repository"]).stdout.strip()
                if shallow == "true":
                    sh(["timeout", "600", "git", "-c", "core.hooksPath=/dev/null",
                        "-C", str(target), "fetch", "--unshallow", "--quiet"])
            if dir_size_mb(target) > SIZE_LIMIT_MB:
                continue
            rp = REPORTS / f"MEMBER-{org}--{login}--{name}.json"
            hist_done = (target / ".orgxray-hist").exists()
            if rp.exists() and not rescan and (not eff_history or hist_done):
                continue
            if stale_repo:
                print(f"  STALE: {login}/{name} — HEAD-only "
                      f"(ingen pushes >{STALE_DAYS}d)")
            gitleaks(target, rp, eff_history)
            if eff_history:
                (target / ".orgxray-hist").write_text("1")
            n = 0
            try:
                n = len(json.loads(rp.read_text()))
            except Exception:
                pass
            fs = []
            if do_deep:
                if time.time() - t0 < REPO_BUDGET_S:
                    fs = deep_scan(target)
                else:
                    print(f"  BUDSJETT: {login}/{name} — {int(time.time()-t0)}s "
                          f"> {REPO_BUDGET_S}s, deep_scan hoppet")
                merge_deep(target, rp, fs)
            if n or fs:
                print(f"  FUNN: {login}/{name} gitleaks={n} deep={len(fs)}")
                total += n + len(fs)
        if do_gists:
            gists = gh(f"users/{login}/gists?per_page=100") or []
            gp = REPORTS / f"MEMBER-{org}--{login}--gists.json"
            gist_all = []
            for g in gists:
                fs = gist_all_revisions(login, g)
                if fs:
                    print(f"  GIST-FUNN: {login} {g.get('description') or g['id']} ({len(fs)})")
                    for f in fs[:3]:
                        print(f"    [{f['RuleID']}] {f['File']} {f['Secret'][:50]}")
                    total += len(fs)
                    gist_all.extend(fs)
            if gist_all:
                persist_gist_report(gp, gist_all)
    print(f"[{org}-members] totalt: {total} funn")

def _merge_gitleaks_report(repo_dir, report_path, tmp_path):
    """Slå sammen ferske gitleaks-funn med eksisterende rapport (dedupe
    per secret+fil). Brukes av watch-members — gitleaks overskriver ellers."""
    try:
        new = json.loads(Path(tmp_path).read_text())
    except Exception:
        new = []
    try:
        old = json.loads(Path(report_path).read_text()) if Path(report_path).exists() else []
    except Exception:
        old = []
    have = set()
    for x in old:
        s = x.get("Secret") or ""
        have.add((_secret_id(s) + "|" + _norm_file(x, repo_dir)) if s else
                 (x.get("RuleID", "") + "|" + _norm_file(x, repo_dir)))
    added = 0
    for f in new:
        s = f.get("Secret") or ""
        dk = (_secret_id(s) + "|" + _norm_file(f, repo_dir)) if s else \
             (f.get("RuleID", "") + "|" + _norm_file(f, repo_dir))
        if dk not in have:
            have.add(dk); old.append(f); added += 1
    Path(report_path).write_text(json.dumps(old, indent=1))
    return added

def watch_members(org, top=144, init_only=False):
    """Rescan kun medlemsrepoer/gists med nye pushes siden sist watch.
    Målet: fange ferske lekker FØR andre — samme rapport-filer som members,
    funn akkumulerer med dedupe."""
    state_file = BASE / f"last-watch-members-{org}.json"
    try:
        state = json.loads(state_file.read_text()) if state_file.exists() else {}
    except Exception:
        state = {}
    logins = committer_logins(org)
    if not logins:
        print(f"[{org}] ingen committer-liste — kjør `orgxray committers {org}` først")
        return
    logins = logins[:top]
    base = REPOS / f"{org}-members"
    base.mkdir(parents=True, exist_ok=True)
    REPORTS.mkdir(parents=True, exist_ok=True)
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    new_state, changed = {}, 0
    for login in logins:
        repos = gh(f"users/{login}/repos?per_page=100") or []
        for repo in repos:
            if repo.get("fork"):
                continue
            key = f"{login}/{repo['name']}"
            pushed = repo.get("pushed_at", "")
            new_state[key] = pushed or now
            if init_only:
                continue
            if pushed and pushed <= state.get(key, ""):
                continue
            target = base / login / repo["name"]
            t0 = time.time()
            if not (target / ".git").exists():
                r = sh(["timeout", "300", "git",
                        "-c", "core.hooksPath=/dev/null", "clone", "--quiet",
                        "--depth", "1", repo["clone_url"], str(target)])
                if r.returncode != 0:
                    continue
            else:
                sh(["git", "-c", "core.hooksPath=/dev/null",
                   "-C", str(target), "pull", "--ff-only", "--quiet"])
            if dir_size_mb(target) > SIZE_LIMIT_MB:
                continue
            rp = REPORTS / f"MEMBER-{org}--{login}--{repo['name']}.json"
            tmp = REPORTS / f".tmp-{login}-{repo['name']}.json"
            gitleaks(target, tmp, False)
            added = _merge_gitleaks_report(target, rp, tmp)
            tmp.unlink(missing_ok=True)
            fs = []
            if time.time() - t0 < REPO_BUDGET_S:
                fs = deep_scan(target)
            else:
                print(f"  BUDSJETT: {key} — deep_scan hoppet")
            added += merge_deep(target, rp, fs)
            if added:
                print(f"  NY-TREFF: {key} (+{added} funn)")
            changed += 1
        for g in (gh(f"users/{login}/gists?per_page=100") or []):
            key = f"{login}/gist:{g['id']}"
            upd = g.get("updated_at", "")
            new_state[key] = upd or now
            if init_only:
                continue
            if upd and upd <= state.get(key, ""):
                continue
            fs = gist_all_revisions(login, g)
            if fs:
                gp = REPORTS / f"MEMBER-{org}--{login}--gists.json"
                persist_gist_report(gp, fs)
                print(f"  GIST-NY: {login} {g.get('description') or g['id']} ({len(fs)})")
                changed += 1
    state_file.write_text(json.dumps(new_state))
    if init_only:
        print(f"[{org}-watch-members] baseline skrevet -> {state_file} "
              f"({len(new_state)} repos/gists)")
    else:
        print(f"[{org}-watch-members] {len(logins)} logins sjekket, "
              f"{changed} repos/gists med endringer")

def digest(path):
    """Repo -> LLM-klar tekst via gitingest. Skriver digest til reports/digests/."""
    import tempfile
    p = Path(path).resolve()
    if not p.is_dir():
        print(f"digest: {p} er ikke en mappe"); return
    out_dir = REPORTS / "digests"
    out_dir.mkdir(parents=True, exist_ok=True)
    slug = p.name.replace("/", "-")
    with tempfile.TemporaryDirectory() as td:
        r = sh(["gitingest", str(p)], cwd=td, timeout=300)
        src = Path(td) / "digest.txt"
        if not src.exists():
            print(f"digest: gitingest feilet for {p.name}")
            return
        dst = out_dir / f"{slug}.txt"
        dst.write_text(src.read_text())
    size = dst.stat().st_size
    print(f"digest: {p.name} -> {dst} ({size/1024:.0f} KiB, "
          f"~{size//4} tokens est.)")

def smell_stats():
    """Kalibrering: smell-funn per regel på tvers av alle rapporter.
    Tier-2-regler med høy noise-rate her kan fremdeles demoteres."""
    per_rule = {}
    for fp in REPORTS.glob("*.json"):
        try:
            raw = json.loads(fp.read_text())
        except Exception:
            continue
        for f in raw:
            if f.get("_smell"):
                r = f.get("RuleID", "?")
                per_rule.setdefault(r, {"n": 0, "files": set()})
                per_rule[r]["n"] += 1
                per_rule[r]["files"].add(fp.stem)
    if not per_rule:
        print("Ingen smell-funn i rapportene ennå."); return
    print(f"{'regel':30} {'funn':>6} {'rapporter':>10}")
    for r, d in sorted(per_rule.items(), key=lambda x: -x[1]["n"]):
        print(f"{r:30} {d['n']:6} {len(d['files']):10}")

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "help"):
        print(__doc__); return
    cmd, rest = args[0], args[1:]
    # bygg-stempel ved skannestart:/live-kode vs stale kopi i container
    # skal være synlig i loggen, ikke bare i runs.jsonl
    if cmd in ("scan", "history", "members", "quick", "deep", "self"):
        print(f"[orgxray] build {_build_stamp()}", file=sys.stderr)
    def opt(flag, default):
        return rest[rest.index(flag)+1] if flag in rest else default
    org = next((a for a in rest if not a.startswith("--")), None)
    if cmd in GATED_CMDS and not check_scope(org):
        return
    if cmd == "discover": discover()
    elif cmd == "stats" and org: stats(org)
    elif cmd == "scan" and org:
        rf = opt("--repos-file", None)
        only = _name_list(rf) if rf else None
        _log_run({"cmd": cmd, "org": org, "repos_file": rf,
                  "repos_file_sha": _file_sha(rf) if rf else None,
                  "n_targets": len(only) if only else "all"})
        scan(org, opt("--strategy","updated"), int(opt("--top",TOPN)), False,
             only=only)
    elif cmd == "history" and org:
        rf = opt("--repos-file", None)
        only = _name_list(rf) if rf else None
        _log_run({"cmd": cmd, "org": org, "repos_file": rf,
                  "repos_file_sha": _file_sha(rf) if rf else None,
                  "n_targets": len(only) if only else "all"})
        scan(org, opt("--strategy","updated"), int(opt("--top",TOPN)), True,
             only=only)
    elif cmd == "people" and org: people(org, opt("--repo",None))
    elif cmd == "committers" and org: committers(org)
    elif cmd == "triage": triage(org or "all")
    elif cmd == "smells": smell_stats()
    elif cmd == "shortlist": shortlist(org)
    elif cmd == "disclose" and org:
        disclose(org, opt("--owner", None), opt("--repo", None))
    elif cmd == "pitch" and org: pitch(org)
    elif cmd == "report": report(org, "--html" in rest)
    elif cmd == "watch": watch(orgs=[org] if org else None, init_only="--init" in rest)
    elif cmd == "watch-members" and org:
        watch_members(org, int(opt("--top", 144)), init_only="--init" in rest)
    elif cmd == "members" and org:
        rescan = "--rescan" in rest
        hist = "--history" in rest
        rf = opt("--repos-file", None)
        _log_run({"cmd": "members", "org": org, "repos_file": rf,
                  "repos_file_sha": _file_sha(rf) if rf else None,
                  "committers": "--committers" in rest, "history": hist})
        if "--committers" in rest:
            members(org, int(opt("--top", 30)), "--no-gists" not in rest,
                   "--no-deep" not in rest, logins=committer_logins(org),
                   rescan=rescan, history=hist, repos_file=rf)
        else:
            members(org, int(opt("--top", 30)), "--no-gists" not in rest,
                   "--no-deep" not in rest, rescan=rescan, history=hist,
                   repos_file=rf)
    elif cmd == "digest" and org:
        digest(org)
    elif cmd == "self":
        self_scan("--no-gists" not in rest, "--no-deep" not in rest)
    elif cmd == "quick":
        target = org or (rest[0] if rest else None)
        days = int(opt("--days", 7))
        if target and Path(target).is_dir():
            fs = quick(target, days)
            if "--json" in rest:
                print(json.dumps(fs, indent=2)); return
            for f in fs[:10]: print(f"  [{f['RuleID']}] {f['File']} {f['Secret'][:60]}")
        else:
            print("bruk: orgxray quick <sti> [--days N]")
    elif cmd == "deep":
        target = org or (rest[0] if rest else None)
        if target and Path(target).is_dir():
            fs = deep_scan(target)
            if "--json" in rest:
                print(json.dumps(fs, indent=2)); return
            print(f"{target}: {len(fs)} deep-funn")
            for f in fs[:10]: print(f"  [{f['RuleID']}] {f['File']} {f['Secret'][:60]}")
        elif org: deep(org)
        else: print("bruk: orgxray deep <org|sti>")
    elif cmd == "orgs":
        for o in KNOWN_ORGS: print(o)
    else:
        print(__doc__)

if __name__ == "__main__":
    main()
