                      f"{f['RuleID']} {f['File']} "
                      f"({f.get('Author','?')[:18]}, {f.get('Date','')[:10]})")
    print(f"\nTOTAL: {total_raw} raw -> {total_kept} etter triage")

def people(org, repo=None):
    """Commit-forfattere i orgens repos -> pitch-targets."""
    PEOPLE.mkdir(parents=True, exist_ok=True)
    org_dir = REPOS / org
    repos = [repo] if repo else [d.name for d in org_dir.iterdir()
                                 if (d / ".git").exists()] if org_dir.exists() else []
    if not repos:
        print(f"[{org}] ingen lokale repos — kjør scan først"); return
    agg = Counter(); emails = {}
    for r in repos:
        d = org_dir / r
        r = sh(["git", "-C", str(d), "shortlog", "-sne", "HEAD"])
        out = "\n".join(r.stdout.splitlines()[:20])
        for line in out.strip().splitlines():
            m = re.match(r"\s*(\d+)\s+(.+?)\s+<([^>]+)>", line)
            if m:
                n, name, email = int(m.group(1)), m.group(2).strip(), m.group(3)
                agg[name] += n
                emails[name] = email
    top = [{"name": n, "email": emails[n], "commits": c}
           for n, c in agg.most_common(15)]
    (PEOPLE / f"{org}.json").write_text(json.dumps(top, indent=2, ensure_ascii=False))
    for p in top[:10]:
        print(f"  {p['commits']:>5}  {p['name']:<30} {p['email']}")

