# ---------- deep-scan: dekoder evasjonslag (base64/hex/reversert/unicode/binær/commit-msg) ----------
import base64, binascii, unicodedata

SECRET_PATTERNS = [
    ("github-pat",        re.compile(r"ghp_[0-9a-zA-Z]{30,}")),
    ("aws-access-token",  re.compile(r"AKIA[0-9A-Z]{16}")),
    ("slack-webhook-url", re.compile(r"https://hooks\.slack\.com/services/[A-Za-z0-9/_-]+")),
    ("api-key-prefix",    re.compile(r"\b(?:sk|pk)-(?:proj-|live-|test-)?[A-Za-z0-9_\-]{20,}")),
    ("generic-api-key",   re.compile(r"(?:api[_-]?key|token|secret|passwd|password)[-_]?[=:]\s*['\"]?([A-Za-z0-9_\-./+]{16,})", re.I)),
    ("jwt",               re.compile(r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}")),
    ("private-key",       re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("db-connection-string", re.compile(
        r"\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp|mssql|"
        r"sqlserver|cockroachdb)://[^/\s:'\"]+:[^@\s'\"]+@[^\s'\"]+", re.I)),
]
# Kjente docs-eksempler som ALDRI skal rapporteres
SECRET_DENY = re.compile(r"EXAMPLE|XXXXX|your[-_ ]?(api[-_ ]?)?key|xxxx+|<[^>]+>|CHANGE[-_]?ME", re.I)
# Homoglyf-kart: forbokstavelige lookalikes (kyrrilisk/gresk) -> latin
CONFUSABLES = str.maketrans({
    "а":"a","е":"e","о":"o","р":"p","с":"c","х":"x","у":"y","і":"i","ј":"j",
    "ѕ":"s","һ":"h","ո":"n","ԛ":"q","ԝ":"w","α":"a","ο":"o","ρ":"p","ν":"v",
    "τ":"t","ι":"i","κ":"k","μ":"u","ɡ":"g","һ":"h","ⲣ":"p","ո":"n","ԝ":"w",
})
ENCODED_CANDIDATE = re.compile(r"\b[A-Za-z0-9+/]{24,}={0,2}\b|\b[0-9a-fA-F]{32,}\b")

IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
CODE_REF = re.compile(r"[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+")  # cfg.X / module.CONST

# «Lathetsfingeravtrykk» — strukturelle misforhold som ikke er secrets,
# men signaliserer Oficina-snarveier (verify=False, debug på, TODO ved creds).
# Persisteres i rapportene for audit, men ekskluderes fra shortlist/disclose.
# Tier-1: presise nok til å surface i triage (score 2). Tier-2: eksperimentelle —
# persisteres i rapport-JSON men scorer under terskelen til kalibrert på data.
# smells-visning: `orgxray smells` aggregerer per regel på tvers av rapporter.
SMELL_RULES = [
    ("smell-tls-verify-off", 1, re.compile(
        r"(verify\s*=\s*False|check_hostname\s*=\s*False|"
        r"CERT_NONE|_create_unverified_context|InsecureRequestWarning)", re.I)),
    ("smell-debug-on", 2, re.compile(
        r"(DEBUG\s*=\s*True|debug\s*=\s*True|FLASK_DEBUG|"
        r"app\.run\([^)]*debug\s*=\s*True|DEBUG_MODE\s*=\s*True)", re.I)),
    ("smell-cors-wildcard", 2, re.compile(
        r"(Access-Control-Allow-Origin['\"]?\s*[:=]\s*['\"]?\*|"
        r"allow_origins\s*=\s*\[?\s*['\"]\*['\"]|cors\(\s*\*|CORS\(\s*\*)", re.I)),
    ("smell-jwt-noverify", 1, re.compile(
        r"(jwt\.decode\([^)]*verify(_signature)?\s*[=:]\s*False|"
        r"options\s*=\s*\{[^}]*verify_signature['\"]?\s*:\s*False|"
        r"verify\s*=\s*False[^)]*jwt)", re.I)),
    # Ren kontekst, aldri et funn i seg selv — score 0, men persisteres
    # slik at «TODO ved creds» er synlig i audit uten å overrapportere.
    ("smell-todo-secret", 2, re.compile(
        r"(TODO|FIXME|HACK|XXX)[^\n]{0,100}"
        r"(secret|api[-_ ]?key|token|password|credential|vault|rotat)", re.I)),
    ("smell-open-bind", 2, re.compile(
        r"(host\s*=\s*['\"]0\.0\.0\.0|listen\s*\(\s*['\"]0\.0\.0\.0|"
        r"0\.0\.0\.0:\d{2,5}|bind\s*\(\s*['\"]?:?:?0\.0\.0\.0)", re.I)),
]

# Default credentials ER et funn, ikke en smell — admin:admin i prod-config
# er like reelt som en lekka nøkkel. Emittes uten _smell, én per unik pair.
DEFAULT_CREDS = re.compile(
    r"\b((admin|root|test|demo|user|administrator|postgres|mysql)"
    r"\s*[:=]\s*['\"]?"
    r"(admin|root|password|passwd|1234|12345|test|qwerty|letmein|changeme|"
    r"secret|admin123)['\"]?)\b", re.I)

# Kontekst som markerer «midlertidig» kode rundt et secret — gir +1 score.
LAZY_CTX = re.compile(
    r"(TODO|FIXME|HACK|XXX|temp(?:orary)?|for now|quick ?fix|workaround|"
    r"not secure|insecure|should (be|use)|move to|vault|rotate|placeholder)",
    re.I)

def _match_smells(text, where, out):
    """Smells (kontekst) + default-creds (ekte funn) i én fil-pass."""
    lines = text.splitlines()
    for rule, tier, pat in SMELL_RULES:
        for i, line in enumerate(lines):
            m = pat.search(line)
            if m:
                out.append({"RuleID": rule, "File": where,
                            "Secret": m.group(0)[:80],
                            "Match": line.strip()[:160],
                            "StartLine": i + 1,
                            "_deep": True, "_smell": True,
                            "_smell_tier": tier, "_rules_rev": RULES_REV})
                break  # én forekomst per regel per fil holder volumet nede
    # default credentials: ekte funn (ingen _smell), én per unik pair, max 5
    seen_pairs = set()
    for i, line in enumerate(lines):
        for m in DEFAULT_CREDS.finditer(line):
            pair = m.group(1).strip("'\" ").lower()
            if pair not in seen_pairs:
                seen_pairs.add(pair)
                out.append({"RuleID": "default-creds", "File": where,
                            "Secret": m.group(1).strip("'\" "),
                            "Match": line.strip()[:160],
                            "StartLine": i + 1, "_deep": True,
                            "_rules_rev": RULES_REV})
                if len(seen_pairs) >= 5:
                    break
        if len(seen_pairs) >= 5:
            break
    # uautentiserte interne tjenester: scheme://uten user:pass@
    for i, line in enumerate(lines):
        for m in re.finditer(
                r"\b((?:mongodb|redis|amqp|mysql|postgres|cockroachdb)"
                r"(?:\+\w+)?://[^\s'\"]+)", line, re.I):
            url = m.group(1)
            if "://" in url:
                after = url.split("://", 1)[1]
                if "@" not in after.split("/")[0]:
                    out.append({"RuleID": "smell-unauth-service",
                                "File": where, "Secret": url[:80],
                                "Match": line.strip()[:160],
                                "StartLine": i + 1,
                                "_deep": True, "_smell": True,
                                "_smell_tier": 2, "_rules_rev": RULES_REV})
                    break
        else:
            continue
        break

# betterleaks-style PREFILTER: attribute-sjekk FØR regex — ser bare
# sti/forfatter/melding, aldri innholdet. Billig bail-out.
# Path-attributtet dekkes allerede av FP_PATH (node_modules, vendor/,
# fixtures, testdata …) som kjøres før _match_secrets overalt.
_PREFILTER_AUTHOR = re.compile(
    r"(?i)\[bot\]|dependabot|renovate|greenkeeper|snyk-bot|"
    r"github-actions|allcontributors|pyup\.bot|imgbot")
_PREFILTER_MSG = re.compile(
    r"(?im)^\s*(chore\(deps\)|build\(deps\)|bump\s+\S+\s+from|"
    r"update\s+(dependency|dep|.*\bto\s+v?\d+\.\d+)|"
    r"merge\s+(pull\s+request|branch|remote-tracking)|revert\b|"
    r"release\s+v?\d|version\s+bump|automated\s+(commit|release)|"
    r"bump\s+version|npm\s+audit|chore:\s+update)")

def prefilter_skip(author="", msg=""):
    """True = attributtene utelukker denne kilden; regex unødvendig.
    KUN attributter (forfatter, melding, sti) — aldri file-innhold.
    OR-semantikk: forfatter-mønster ELLER melding-mønster.
    Melding-mønsteret søkes KUN i subject-linjen (første linje,
    max 300 tegn): body-tekst kan inneholde «merge …» i sitat/prosa
    uten at committen er støy — og et dep-mønster dypt i body skal
    ikke skille ut hele committen (den kan bære ekte secrets).
    Avkortingen er kun input til søket; den kan ALDRI forårsake
    over-skipping, høyst under-skipping (trygg retning)."""
    subject = (msg or "").split("\n", 1)[0][:300]
    return bool(_PREFILTER_AUTHOR.search(author or "") or
                _PREFILTER_MSG.search(subject))

def _match_secrets(text, where, out, seen, strong_only=False):
    for variant, vname in ((text, ""), (text.translate(CONFUSABLES), " [homoglyph]")):
        for rule, pat in SECRET_PATTERNS:
            if strong_only and rule == "generic-api-key": continue
            for m in pat.finditer(variant):
                val = next((g for g in reversed(m.groups()) if g), m.group(0))
                if SECRET_DENY.search(val) or val in seen: continue
                if rule == "generic-api-key" and (IDENTIFIER.fullmatch(val) or CODE_REF.fullmatch(val)): continue
                # BPE token-efficiency (betterleaks «Rare Not Random»):
                # forkaster naturlig-språk-kandidater før de blir funn.
                if rule == "generic-api-key" and len(val) >= 8 \
                        and fails_token_efficiency(val):
                    continue
                if any(len(s) > 15 and (val.startswith(s) or s.startswith(val)) for s in seen):
                    continue  # prefix-duplikat (f.eks. corpus-stripped som sluker neste tokens prefix)
                seen.add(val)
                # Full secret, ingen trunkering: _secret_id(hasher) må matche
                # gitleaks' fulle verdi —enhver grense skaper duplikater for
                # lange hemmeligheter (JWT, PEM, private keys, base64-blobs).
                out.append({"RuleID": rule, "File": where+vname, "Secret": val,
                            "Match": m.group(0)[:160], "_deep": True,
                            "_rules_rev": RULES_REV})

def deep_scan(path, only=None):
    """Scan en lokal repo for kodede/skjulte secrets som gitleaks overser.
    Dekker: base64, hex, reverserte tokens, unicode-normalisering,
    binærfiler, commit-meldinger. Splitt-over-filer dekkes IKKE.
    only=set(rel-paths) -> bare de filene (quick/diff-modus)."""
    path = Path(path)
    out, seen = [], set()
    # 1) alle tekstfiler i HEAD-treet
    files = sh(["git","-C",str(path),"ls-files"]).stdout.splitlines()
    if only is not None:
        files = [f for f in files if f in only]
    for rel in files:
        if FP_PATH.search(rel): continue
        fp = path / rel
        try:
            raw = fp.read_bytes()
        except Exception:
            continue
        if len(raw) > 2_000_000: continue
        text = raw.decode("utf-8", "ignore")
        norm = unicodedata.normalize("NFKC", text)
        _match_secrets(norm, rel, out, seen)
        _match_smells(text, rel, out)
        # 2) kodede kandidater -> decoded rescan
        for m in ENCODED_CANDIDATE.finditer(norm):
            tok = m.group(0)
            for dec in _try_decode(tok):
                _match_secrets(dec, f"{rel} [decoded]", out, seen)
            # 3) reversert token
            _match_secrets(tok[::-1], f"{rel} [reversed]", out, seen)
    # 4) binærfiler: regex på rå bytes
    for rel in files:
        fp = path / rel
        try: raw = fp.read_bytes()
        except Exception: continue
        if b"\x00" in raw[:4096]:  # sannsynlig binær
            _match_secrets(raw.decode("latin-1"), rel+" [binary]", out, seen)
    if only is not None:
        return out  # quick-modus: bare endrede filer, ingen repo-nivå-pass
    # 4) andre grener: scann filer som IKKE er i HEAD-treet
    head_files = set(files)
    refs = sh(["git","-C",str(path),"for-each-ref","--format=%(refname:short)","refs/heads"]).stdout.split()
    for ref in refs:
        if ref in ("HEAD",): continue
        tree = sh(["git","-C",str(path),"ls-tree","-r","--name-only",ref]).stdout.splitlines()
        for rel in tree[:2000]:
            if rel in head_files: continue
            blob = sh(["git","-C",str(path),"show",f"{ref}:{rel}"])
            if len(blob.stdout) > 2_000_000: continue
            _match_secrets(blob.stdout, f"{rel} [{ref}]", out, seen)
    # 5) splitt-over-filer: concatener alt lite tekstinnhold, whitespace-strippet
    small = []
    for rel in files[:500]:
        if FP_PATH.search(rel): continue
        try:
            t = (path/rel).read_text(errors="ignore")
        except Exception: continue
        if 0 < len(t) < 4000: small.append(t)
    joined = "".join(small)
    _match_secrets(joined, "[corpus-joined]", out, seen, strong_only=True)
    _match_secrets(re.sub(r"\s+", "", joined), "[corpus-stripped]", out, seen, strong_only=True)
    # 6) commit-meldinger — prefilter på forfatter+melding FØR regex
    #    (bedreleaks prefilter: bot/dep-bump-commits kaster vi vekk
    #    uten å costing en eneste pattern-match).
    log = sh(["git","-C",str(path),"log","--all",
              "--format=%an%x01%B%x00"]).stdout
    for chunk in log.split("\x00"):
        author, _, msg = chunk.partition("\x01")
        if prefilter_skip(author, msg): continue
        _match_secrets(msg, "[commit-message]", out, seen)
    # 7) historikk: Kun diff-linjer som matcher sterke secret-prefikser (-G = pickaxe,
    #    kraftig filtrering => lite output selv på store repos)
    diff = sh(["git","-C",str(path),"log","--all","-p","--no-color","-n","300",
               "-G",r"ghp_|github_pat_|AKIA[0-9A-Z]|hooks\.slack\.com|PRIVATE KEY|sk-(proj|live|test)-|eyJ[A-Za-z0-9_-]{10,}\."]).stdout
    added = "\n".join(l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++"))
    _match_secrets(added, "[history-diff]", out, seen)
    for m in ENCODED_CANDIDATE.finditer(added):
        for dec in _try_decode(m.group(0)):
            _match_secrets(dec, "[history-diff decoded]", out, seen)
    return out

def quick(path, days=7):
    """Diff-scoped scan: bare filer endret siste `days` dager + ulcommittede.
    Mye raskere enn full deep_scan på store repos — watch/CI-lignende pass.
    NB: historikk, andre grener, commit-meldinger og corpus-join dekkes
    IKKE — historikk-lekasjer fanges bare av full scan/history."""
    path = Path(path)
    if not (path / ".git").exists():
        print(f"{path}: ikke en git-repo"); return []
    log = sh(["git","-C",str(path),"log",f"--since={days} days ago",
              "--name-only","--pretty=format:","--diff-filter=ACMR"]).stdout
    changed = {l.strip() for l in log.splitlines() if l.strip()}
    for l in sh(["git","-C",str(path),"status","--porcelain"]).stdout.splitlines():
        if len(l) > 3:
            changed.add(l[3:].split(" -> ")[-1].strip().strip('"'))
    changed.discard("")
    if not changed:
        print(f"{path}: ingen endringer siste {days}d"); return []
    fs = deep_scan(path, only=changed)
    _log_run({"cmd": "quick", "path": str(path), "days": days,
              "n_files": len(changed),
              "files_sha": hashlib.sha256(
                  "\n".join(sorted(changed)).encode()).hexdigest()[:16],
              "files": sorted(changed)[:500],
              "n_findings": len(fs)})
    print(f"{path}: quick {len(changed)} filer -> {len(fs)} funn")
    return fs

def _name_list(path):
    """Target-liste: én repo per linje, '#'-kommentarer og blanke linjer
    ignoreres. 'owner/repo' og 'repo' matcher likt."""
    out = set()
    for line in Path(path).read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line: out.add(line)
    return out

def _try_decode(tok):
    """Prøv base64 og hex-decode; returner lesbar tekst hvis gyldig."""
    res = []
    try:
        padded = tok + "=" * (-len(tok) % 4)
        b = base64.b64decode(padded, validate=True)
        t = b.decode("utf-8", "ignore")
        if len(t) >= 8 and all(31 < ord(c) < 127 or c in "\n\t" for c in t[:200]):
            res.append(t)
    except Exception: pass
    try:
        if len(tok) % 2 == 0:
            t = binascii.unhexlify(tok).decode("utf-8", "ignore")
            if len(t) >= 8: res.append(t)
    except Exception: pass
    return res

def gist_findings(gid, files):
    """Scan ett sett gist-filer (nåværende revisjon eller én historikk-versjon)."""
    out = []
    for fname, fobj in (files or {}).items():
        raw = fobj.get("raw_url")
        if not raw or fobj.get("size", 0) > 2_000_000:
            continue
        content = sh(["curl", "-sL", "--max-time", "20", raw]).stdout
        if not content:
            continue
        fs = []
        _match_secrets(content, f"gist:{gid}:{fname}", fs, set())
        for m2 in ENCODED_CANDIDATE.finditer(content):
            for dec in _try_decode(m2.group(0)):
                _match_secrets(dec, f"gist:{gid}:{fname} [decoded]", fs, set())
        out.extend(fs)
    return out

def gist_all_revisions(login, g, do_revs=True):
    """Nåværende filer + alle historikk-revisjoner (gists beholder slettet innhold)."""
    gid = g["id"]
    fs = gist_findings(gid, g.get("files"))
    if not do_revs:
        return fs
    detail = gh(f"gists/{gid}")
    for rev in ((detail or {}).get("history") or [])[1:]:
        sha = rev.get("version")
        if not sha:
            continue
        rdata = gh(f"gists/{gid}/{sha}")
        fs += gist_findings(gid, (rdata or {}).get("files"))
    return fs

def persist_gist_report(path, findings):
    try:
        old = json.loads(path.read_text()) if path.exists() else []
    except Exception:
        old = []
    old.extend(findings)
    path.write_text(json.dumps(old, indent=1))

def merge_deep(repo_dir, report_path, fs=None):
    """Legg deep-scan-funn i rapport-JSON-en (dekket tidligere bare printet = tapt).
    File lagres som absolutt sti + surface-suffix, så secret_in_head finner den."""
    if fs is None:
        fs = deep_scan(repo_dir)
    if not fs:
        return 0
    try:
        old = json.loads(report_path.read_text()) if report_path.exists() else []
    except Exception:
        old = []
    have = set()
    for x in old:
        s = x.get("Secret") or ""
        have.add((_secret_id(s) + "|" + _norm_file(x, repo_dir)) if s else
                 (x.get("RuleID", "") + "|" + _norm_file(x, repo_dir)))
    new = []
    for f in fs:
        s = f.get("Secret") or ""
        rel = _strip_surface(f.get("File", ""))
        if rel.startswith("[") or rel.startswith("gist:"):
            absfile = f.get("File", "")
        else:
            absfile = str(Path(repo_dir) / rel) + f.get("File", "")[len(rel):]
        f2 = dict(f)
        # Repo-relativ sti er primærnøkkel (portabel rapport); absolutt i _abspath
        f2["File"] = f.get("File", "")
        f2["_abspath"] = absfile
        f2["_sid"] = _secret_id(s)
        dk = (_secret_id(s) + "|" + _norm_file(f2, repo_dir)) if s else \
             (f.get("RuleID", "") + "|" + _norm_file(f2, repo_dir))
        if dk not in have:
            have.add(dk)
            new.append(f2)
    if new:
        report_path.write_text(json.dumps(old + new, indent=1))
    return len(new)

def deep(org):
    """Kjør deep-scan på alle lokale kloner for en org."""
    base = REPOS / org
    if not base.exists():
        print(f"[{org}] ingen lokale repos — kjør scan først"); return
    total = 0
    for d in sorted(base.iterdir()):
        if not (d/".git").exists(): continue
        fs = deep_scan(d)
        if fs:
            print(f"  {d.name}: {len(fs)} deep-funn")
            for f in fs[:5]:
                print(f"    [{f['RuleID']}] {f['File']} {f['Secret'][:50]}")
            total += len(fs)
    print(f"[{org}] deep-scan total: {total} funn")
    return total

def self_scan(do_gists=True, do_deep=True):
    """Scan EGEN GitHub-profil (repos + gists) for leaks — 'har jeg selv
    vært uforsiktig?'. Bruker gh-auth, krever ingen org."""
    me = gh("user")
    if not me:
        print("[self] ingen gh-auth — kjør 'gh auth login' først"); return
    login = me["login"]
    base = REPOS / "self"
    base.mkdir(parents=True, exist_ok=True)
    REPORTS.mkdir(parents=True, exist_ok=True)
    repos = gh("user/repos?per_page=100&visibility=public&affiliation=owner") or []
    repos = [r for r in repos if not r.get("fork") and not r.get("private")]
    print(f"[self] {login}: {len(repos)} offentlige repos")
    total = 0
    for repo in repos:
        name = repo["name"]
        target = base / name
        if not (target / ".git").exists():
            r = sh(["timeout", "300", "git",
                    "-c", "core.hooksPath=/dev/null", "clone", "--quiet",
                    repo["clone_url"], str(target)])
            if r.returncode != 0:
                continue
        elif sh(["git", "-C", str(target), "rev-parse",
                 "--is-shallow-repository"]).stdout.strip() == "true":
            sh(["timeout", "600", "git", "-c", "core.hooksPath=/dev/null",
                "-C", str(target), "fetch", "--unshallow", "--quiet"])
        if dir_size_mb(target) > SIZE_LIMIT_MB:
            continue
        rp = REPORTS / f"SELF--{login}--{name}.json"
        gitleaks(target, rp, True)
        n = 0
        try:
            n = len(json.loads(rp.read_text()))
        except Exception:
            pass
        fs = deep_scan(target) if do_deep else []
        if do_deep:
            merge_deep(target, rp, fs)
        if n or fs:
            print(f"  FUNN: {login}/{name} gitleaks={n} deep={len(fs)}")
            total += n + len(fs)
    if do_gists:
        gists = gh(f"users/{login}/gists?per_page=100") or []
        gp = REPORTS / f"SELF--{login}--gists.json"
        gist_all = []
