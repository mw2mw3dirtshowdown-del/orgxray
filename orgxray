            repo = parts[1] if len(parts) == 2 else ""
            orgname = fp.stem.split("-", 1)[1].split("--", 1)[0] if "-" in fp.stem else ""
        kept = triage_findings(raw)
        if repo_dir:
            kept = classify_findings(kept, orgname, repo, repo_dir)
        total_raw += len(raw); total_kept += len(kept)
        if kept:
            live = sum(1 for f in kept if f.get("_status") == "LIVE")
            print(f"{fp.name}: {len(raw)} raw -> {len(kept)} etter triage ({live} LIVE)")
            for f in kept[:5]:
