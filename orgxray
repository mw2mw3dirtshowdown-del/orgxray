def _cred_class(f):
    """Klassifiser funnet i en credential-klasse for mappestruktur.
    Klasse = rotasjons-runbook, ikke bare regelnavn."""
    rule = f.get("RuleID", "")
    var = (f.get("_var") or "").upper()
    path = f.get("File", "")
    secret = (f.get("Secret") or f.get("Match") or "")[:80]
    if rule == "private-key" or re.search(
            r"\.pem$|\.key$|id_rsa|id_ed25519|PRIVATE KEY", path + secret, re.I):
        return "private-keys"
    if rule == "db-connection-string" or re.match(
            r"(postgres|mysql|mongodb(\+srv)?|redis|amqp|mssql|sqlserver|"
            r"cockroachdb)://", secret, re.I):
        return "dsn"
    if re.search(r"(JWT|SESSION|SIGNING|COOKIE)[_-]?(SECRET|KEY|SALT)|"
                 r"(SECRET|KEY)[_-]?(FOR|_)(JWT|SESSION)", var):
        return "signing-keys"
    if re.search(r"PASS(WOR)?D|_PWD|DB_PASS|DATABASE", var):
        return "passwords"
    if rule in ("github-pat", "github-app-token", "aws-access-token",
                "stripe-access-token", "slack-webhook-url", "jwt"):
        return "tokens"
    if rule in ("gcp-api-key", "azure-storage-key", "kubernetes-secret-yaml"):
        return "api-keys"
    if rule == "generic-api-key":
        return "passwords" if re.search(r"PASS|PWD|DATABASE", var) \
            else "api-keys"
    return "other"

def _fingerprint(secret):
    """Sikker identifikator uten hemmelighetsmateriale: prefix + sha256-short + lengde."""
    if not secret:
        return "(tom)"
    h = hashlib.sha256(secret.encode()).hexdigest()[:12]
    return f"{secret[:6]}… (sha256:{h}, {len(secret)} chars)"

def _first_seen(repo_dir, rel_path):
    """Dato + kort commit-hash for FØRSTE commit som rørte filen (eksponering-start)."""
    if not repo_dir or not rel_path or rel_path.startswith("gist:"):
        return "", ""
    r = sh(["git", "-C", str(repo_dir), "log",
            "--format=%as %h", "--", rel_path])
    lines = r.stdout.strip().splitlines()
    if r.returncode != 0 or not lines:
        return "", ""
    date, _, commit = lines[-1].partition(" ")  # eldste commit = siste linje
    return date, commit

def render_disclosure(org, owner, repo, findings, repo_dir=None):
    """Markdown-draft for responsible disclosure. Aldri full secret-verdi."""
    repo_url = (f"github.com/{org}/{repo}" if owner == "org"
                else f"github.com/{owner}/{repo}")
    today = time.strftime("%Y-%m-%d")
    lines = [
        f"# Responsible Disclosure — Exposed credentials in public repository",
        "",
        f"**To:** {org} security team",
        f"**Date:** {today}",
        "**Reporter:** Sondre (independent security researcher)",
        "**Severity estimate:** See per-finding notes — validity NOT verified "
        "by reporter (deliberate; see 'What we did NOT do').",
        "",
        "## Summary",
        "",
        f"Public repository `{repo_url}` contains what appear to be "
        "credentials committed in plaintext. Files are present at HEAD; "
        "public `git clone` suffices — no authentication was used.",
        "",
        "## Affected assets",
        "",
        "| File | Credential type | Fingerprint | First seen |",
        "|---|---|---|---|",
    ]
    seen = set()
    for f in findings:
        fp = _fingerprint(f.get("Secret", ""))
        key = (f.get("File"), fp)
        if key in seen:
            continue
        seen.add(key)
        fpath = str(f.get("File", ""))
        if repo_dir and os.path.isabs(fpath):
            rel = os.path.relpath(fpath, str(repo_dir))
            if rel.startswith(".."):
                rel = fpath.split("repos/")[-1]
        else:
            rel = fpath.split("repos/")[-1] if "repos/" in fpath else fpath
        fdate, fcommit = _first_seen(repo_dir, rel)
        lines.append(
            f"| `{rel}` | {RULE_DESC.get(f.get('RuleID'), f.get('RuleID'))} "
            f"| `{fp}` | {fdate or str(f.get('Date',''))[:10]} "
            f"`{fcommit or str(f.get('Commit',''))[:10]}` |")
    lines += [
        "",
        "## Evidence",
        "",
        "- Each finding was verified present at HEAD via `git show HEAD:<path>`",
        "  on a local clone; secret material matches byte-for-byte.",
        "- Fingerprints above are `prefix… + sha256[:12] + length` — enough to",
        "  confirm identity without exposing usable key material.",
        "- Full secret values are intentionally NOT included.",
        "",
        "## Caveats",
        "",
        "- Findings may be test/fixture/dev credentials rather than",
        "  production secrets. Impact depends on what the credential grants.",
        "- Reporter did not test validity — please verify server-side.",
        "- If the credential is live: rotate/revoke it and scrub git history",
        "  (deleting the file does not remove it from history).",
        "",
        "## What we did NOT do",
        "",
        "- Did not call any service with the credentials.",
        "- Did not access any systems or data.",
        "- Did not include usable secret material in this report.",
        "",
        "## Contact",
        "",
        "Reply to this report or via the org's published security channel. "
        "Happy to provide the local clone path and commit hashes for "
        "verification.",
        "",
    ]
    return "\n".join(lines)

def _redacted_finding(f, repo_dir=None):
    """Evidence-post for findings.json — ALDRI full secret-verdi."""
    commit, date = f.get("Commit", ""), f.get("Date", "")
    if not commit and repo_dir:  # dir-mode-funn mangler git-metadata
        fs_date, fs_hash = _first_seen(repo_dir, _norm_file(f, repo_dir))
        commit, date = fs_hash, fs_date
    return {
        "class": _cred_class(f),
        "rule": f.get("RuleID", ""),
        "file": _norm_file(f, repo_dir) if repo_dir else _strip_surface(f.get("File", "")),
        "surface": (f.get("File", "")[len(_strip_surface(f.get("File", ""))):]
                    .strip(" []") or None),
        "line": f.get("StartLine"),
        "var": f.get("_var") or None,
        "commit": commit,
        "date": date,
        "status": f.get("_status", ""),
        "quality": f.get("_quality", ""),
        "score": f.get("_score", 0),
        "fingerprint": _fingerprint(f.get("Secret", "")),
        "also_in": f.get("_also_in") or None,
    }

def write_case_index(outdir, rows):
    """index.md — oversikt over alle genererte disclosure-saker."""
    lines = ["# OrgXray — disclosure cases", "",
             f"Generert {time.strftime('%Y-%m-%d %H:%M')} · {len(rows)} saker", "",
             "| Org | Repo | Eier | Funn | Topscore | Status | Mappe |",
             "|---|---|---|---|---|---|---|"]
    for r in sorted(rows, key=lambda x: (-(x["score"]
                        if isinstance(x["score"], int) else 0), str(x["org"]))):
        lines.append(
            f"| {r['org']} | {r['repo']} | {r['owner']} | {r['count']} | "
            f"{r['score']} | {r['status']} | `{r['dir']}/` |")
    (outdir / "index.md").write_text("\n".join(lines) + "\n")

def disclose(org, owner=None, repo=None, want="high"):
    """Generer disclosure-saker i ~/disclosures/<org>/<eier>-<repo>/.
    Hver sak: disclosure.md (draft) + findings.json (redacted evidence) + README.md."""
    outdir = Path.home() / "disclosures"
    outdir.mkdir(exist_ok=True)
    groups = {}
    for orgname, ow, rp, rd, f in iter_all_triaged(org):
        if owner and ow != owner:
            continue
        if repo and rp != repo:
            continue
        if f.get("_status") != "LIVE" or f.get("_quality") != want \
                or f.get("_smell"):
            continue
        groups.setdefault((orgname, ow, rp), {"findings": [], "repo_dir": rd})
        groups[(orgname, ow, rp)]["findings"].append(f)
    if not groups:
        print(f"ingen LIVE+{want}-funn for {org or 'all'}")
        return
    index_rows = []
    for (orgname, ow, rp), g in sorted(groups.items()):
        fs = g["findings"]
        slug = re.sub(r"[^a-z0-9]+", "-",
                      f"{ow}-{rp}".lower()).strip("-")
        cdir = outdir / orgname.lower() / slug
        cdir.mkdir(parents=True, exist_ok=True)
        # Krysslenk samme secret på tvers av filer i denne casen
        sid_files = {}
        for f in fs:
            sid_files.setdefault(f.get("_sid") or "", set()).add(
                _norm_file(f, g["repo_dir"]))
        for f in fs:
            sid = f.get("_sid") or ""
            others = sorted(sid_files.get(sid, set()) -
                            {_norm_file(f, g["repo_dir"])})
            f["_also_in"] = others or None
        (cdir / "disclosure.md").write_text(
            render_disclosure(orgname, ow, rp, fs, g["repo_dir"]))
        (cdir / "findings.json").write_text(json.dumps(
            [_redacted_finding(f, g["repo_dir"]) for f in fs], indent=1))
        # Én evidens-fil per funn, gruppert etter credential-klasse
        shutil.rmtree(cdir / "credentials", ignore_errors=True)
        by_class = defaultdict(list)
        for f in fs:
            by_class[_cred_class(f)].append(f)
        cred_root = cdir / "credentials"
        for cls in CRED_CLASSES:
            if cls not in by_class:
                continue
            cdir_cls = cred_root / cls
            cdir_cls.mkdir(parents=True, exist_ok=True)
            for i, f in enumerate(by_class[cls], 1):
                ev = _redacted_finding(f, g["repo_dir"])
                var = ev.get("var") or ev["rule"]
                slug_f = re.sub(r"[^a-z0-9]+", "-",
                                f"{var}-{ev['file']}".lower()).strip("-")[:80]
                body = [
                    f"# {cls} — {var}", "",
                    f"- **Repo:** `{orgname}/{rp}` ({'org' if ow == 'org' else ow})",
                    f"- **Fil:** `{ev['file']}`"
                    + (f" (surface: `{ev['surface']}`)" if ev.get("surface") else ""),
                    f"- **Linje:** {ev.get('line') or '-'}",
                    f"- **Variabel:** `{ev.get('var') or '-'}`",
                    f"- **Regel:** {RULE_DESC.get(ev['rule'], ev['rule'])}",
                    f"- **Status:** {ev.get('status')} · quality {ev.get('quality')}"
                    f" · score {ev.get('score')}",
                    f"- **Først sett:** {ev.get('date') or '-'} `{ev.get('commit') or '-'}`",
                    f"- **Fingeravtrykk:** `{ev['fingerprint']}`",
                ]
                if ev.get("also_in"):
                    body.append(f"- **Også i:** {', '.join('`'+a+'`' for a in ev['also_in'])}")
                body += [
                    "",
                    "Verdien er med hensikt utelatt — kun fingerprint "
                    "(prefix + sha256[:12] + lengde). Aldri full secret.",
                    "",
                ]
                (cdir_cls / f"{i:02d}-{slug_f}.md").write_text("\n".join(body))
        top = max(x.get("_score", 0) for x in fs)
        class_summary = ", ".join(
            f"{cls}: {len(v)}" for cls, v in sorted(by_class.items()))
        (cdir / "README.md").write_text(
            f"# {orgname} / {ow} / {rp}\n\n"
            f"- {len(fs)} funn · toppscore {top} · generert "
            f"{time.strftime('%Y-%m-%d')}\n"
            f"- Klasser: {class_summary}\n"
            f"- `disclosure.md` — draft til responsible disclosure (IKKE sendt)\n"
            f"- `findings.json` — redacted evidence (fingerprint, ingen secrets)\n"
            f"- `credentials/<klasse>/` — én evidens-fil per funn\n")
        index_rows.append({
            "org": orgname, "repo": rp, "owner": ow, "count": len(fs),
            "score": top, "status": "LIVE+" + want,
            "dir": f"{orgname.lower()}/{slug}"})
        # Høy-sensitivitet → automatisk avskilt vault-kopi med worklog
        if isinstance(top, int) and top >= VAULT_MIN_SCORE:
            vcase = VAULT_DIR / orgname.lower() / slug
            if vcase.exists():
                shutil.rmtree(vcase)
            shutil.copytree(cdir, vcase)
            (vcase / "WORKLOG.md").write_text(
                _worklog(orgname, ow, rp, fs, g["repo_dir"]))
            print(f"  vault: {vcase}/ (score {top} ≥ {VAULT_MIN_SCORE})")
        print(f"sak: {cdir}/ ({len(fs)} funn, score {top})")
    # Bevar index over ALLE tidligere genererte mapper også
    new_dirs = {r["dir"] for r in index_rows}
    old = []
    for sub in outdir.iterdir():
        if not sub.is_dir():
            continue
        for case in sub.iterdir():
            d = f"{sub.name}/{case.name}"
            if case.is_dir() and (case / "README.md").exists() \
                    and d not in new_dirs:
                old.append({
                    "org": sub.name, "repo": case.name, "owner": "-",
                    "count": "-", "score": "-", "status": "tidligere",
                    "dir": d})
    write_case_index(outdir, index_rows + old)
    write_type_index(outdir)
    write_vault_index()
    print(f"index: {outdir}/index.md")

def _worklog(orgname, ow, rp, fs, repo_dir):
    """Menneskelig readable beretning: hva som ble gjort, hvordan, og hva
    som bevisst IKKE ble gjort. Skrives til vault-kopien av casen."""
    today = time.strftime("%Y-%m-%d %H:%M")
    src = ("organisasjonens eget repo (org-scan)" if ow == "org"
           else f"medlemsrepo hos `{ow}` (members/committers-scan)")
    top = max(x.get("_score", 0) for x in fs)
    lines = [
        "# Worklog — OrgXray sak", "",
        f"- **Sak:** `{orgname}` / `{ow}` / `{rp}`",
        f"- **Generert:** {today}",
        f"- **Kilde:** {src}",
        f"- **Antall funn:** {len(fs)} · toppscore {top}",
        "",
        "## Metode — hva som ble gjort, steg for steg", "",
        "1. **Innhenting:** Offentlig GitHub-data via API — repo-kloning "
        "og/eller gist-henting. Ingen autentisering mot målet; eneste "
        "nettverkstrafikk er-lesende GitHub-API/kall.",
        "2. **Deteksjon:** `gitleaks` (regex-regler for kjente "
        "secret-formater) + OrgXray deep-scan (base64/hex-dekoding, "
        "reverserte strenger, binærfiler, commit-meldingskorpus).",
        "3. **Verifisering:** Hvert funn klassifiseres LIVE / HIST / UNK "
        "ved sjekk mot `git show HEAD:<fil>` på lokal klon. LIVE = "
        "hemmelighetsstrengen er byte-for-byte til stede i HEAD.",
        "4. **Dedupe:** Samme secret i samme fil på tvers av commits "
        "collapses til én rad; samme secret i ulike filer lenkes via "
        "`also_in` — én rotasjon, ikke flere uavhengige lekasjer.",
        "5. **First-seen:** `git log` over filens historikk gir den "
        "ELDSTe commit som rørte filen — eksponeringens startdato.",
        "6. **Triage:** Score (regeltype + filsti + variabelkontekst, "
        "signeringsnøkkel-boost cappet) og quality (placeholder-, "
        "test-fixture- og public-by-design-filtre).",
        "7. **Pakking:** Kun redacted evidence — fingerprint "
        "(prefix + sha256[:12] + lengde). Full secret-verdi skrives "
        "ALDRI til disk i denne mappen.",
        "",
        "## Funn — beviskjede", "",
        "| Fil | Klasse | Regel | Status | Score | Først sett | Fingeravtrykk |",
        "|---|---|---|---|---|---|---|",
    ]
    for f in fs:
        ev = _redacted_finding(f, repo_dir)
        lines.append(
            f"| `{ev['file']}` | {ev['class']} | "
            f"{RULE_DESC.get(ev['rule'], ev['rule'])} | {ev['status']} | "
            f"{ev['score']} | {ev.get('date') or '-'} "
            f"`{ev.get('commit') or '-'}` | `{ev['fingerprint']}` |")
    lines += [
        "",
        "## Hva vi IKKE gjorde", "",
        "- Ingen validering av credentials mot live tjenester.",
        "- Ingen tilgang til systemer, data eller API-er.",
        "- Ingen full secret-verdi i noen fil i denne mappen.",
        "- Ingenting er sendt til orgen — `disclosure.md` er et draft "
        "som venter på manuell review.",
        "",
        "## Hvorfor denne mappen er avskilt", "",
        f"Topp score i casen er {top} — over grensen "
        f"{VAULT_MIN_SCORE} for høy-sensitivitet "
        "(signeringsnøkler, passord, private keys, DSN). "
        "Innholdet er sensitivt nok til at det ikke skal ligge i "
        "den ordinære disclosures-mappen.",
        "",
    ]
    return "\n".join(lines)

def write_vault_index():
    """~/disclosures-vault/index.md — oversikt over avskilte høy-sensitivitetssaker."""
    VAULT_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(VAULT_DIR, 0o700)
    rows = []
    for case in sorted(VAULT_DIR.glob("*/*")):
        fj = case / "findings.json"
        if not (case / "WORKLOG.md").exists() or not fj.exists():
            continue
        try:
            n = len(json.loads(fj.read_text()))
        except Exception:
            n = "?"
        rows.append((case.parent.name, case.name, n))
    lines = ["# OrgXray — vault (høy-sensitivitet)", "",
             f"Automatisk kopier av saker med toppscore ≥ {VAULT_MIN_SCORE}. "
             "Hver sak har `WORKLOG.md` med manuell-readable metodebeskrivelse.",
             "", "| Org | Sak | Funn |", "|---|---|---|"]
    for org, case, n in rows:
        lines.append(f"| {org} | `{case}/` | {n} |")
    lines.append("")
    (VAULT_DIR / "index.md").write_text("\n".join(lines))

def write_type_index(outdir):
    """~/disclosures/types/<klasse>.md — alle funn gruppert etter
    credential-klasse på tvers av alle genererte saker."""
    tdir = outdir / "types"
    tdir.mkdir(exist_ok=True)
    by_class = defaultdict(list)
    for jf in outdir.glob("*/*/findings.json"):
        org_dir, case_dir = jf.parent.parent.name, jf.parent.name
        try:
            items = json.loads(jf.read_text())
        except Exception:
            continue
        for it in items:
            it = dict(it)
            it["_case"] = f"{org_dir}/{case_dir}"
            by_class[it.get("class") or "other"].append(it)
    lines = ["# OrgXray — funn per credential-type", "",
             "Én fil per klasse. Hver linje: sak, fil, variabel, status, "
             "score, fingeravtrykk. Aldri full secret.", ""]
    for cls in CRED_CLASSES:
        items = by_class.get(cls)
        if not items:
            continue
        lines += [f"## {cls} ({len(items)})", "",
                  "| Sak | Fil | Variabel | Status | Score | Fingeravtrykk |",
                  "|---|---|---|---|---|---|"]
        cls_rows = []
        for it in sorted(items, key=lambda x: -(x.get("score") or 0)):
            row = (f"| `{it['_case']}` | `{it.get('file','')}` | "
                   f"`{it.get('var') or '-'}` | {it.get('status','')} | "
                   f"{it.get('score','')} | `{it.get('fingerprint','')}` |")
            cls_rows.append(row)
            lines.append(row)
        lines.append("")
        (tdir / f"{cls}.md").write_text("\n".join(
            [f"# {cls} — {len(items)} funn", "",
             "| Sak | Fil | Variabel | Status | Score | Fingeravtrykk |",
             "|---|---|---|---|---|---|"] + cls_rows) + "\n")
    (tdir / "index.md").write_text("\n".join(lines))

def report(org=None, html=False):
    per_repo = []
    agg = Counter()
    live_count = 0
    all_findings = []
    for repo, f in iter_triaged(org):
        per_repo.append((f"{repo}", f))
        agg[f["RuleID"]] += 1
        if f.get("_status") == "LIVE":
            live_count += 1
        all_findings.append((repo, f))
    by_repo = Counter(r for r, _ in all_findings)
    print("== TOP funn (etter triage) ==")
    for rule, n in agg.most_common(15):
        print(f"  {n:>4}  {rule}")
    print(f"\n== Status: {live_count} LIVE (i HEAD) / {len(all_findings)-live_count} HIST ==")
    print("\n== Repos med funn ==")
    for name, n in by_repo.most_common(20):
        print(f"  {n:>4}  {name}")
    if html:
        html_report(org or "all", agg, by_repo, all_findings, live_count)

