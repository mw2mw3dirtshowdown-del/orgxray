    for fp in files:
        try:
            raw = json.loads(fp.read_text())
        except Exception:
            continue
        # repo-navn + org fra filnavn: HIST-<org>--<repo>.json / DIR-...
        # MEMBER-<org>--<login>--<repo>.json → repos/<org>-members/<login>/<repo>
        repo_dir = None
