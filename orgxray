def iter_all_triaged(org=None):
    """Yield (org, owner, repo, repo_dir, finding) for DIR/HIST/MEMBER-rapporter.
    'owner' er 'org' for org-repos, GitHub-login for member-repos."""
    for fp in sorted(REPORTS.glob("*.json")):
        try:
            raw = json.loads(fp.read_text())
        except Exception:
            continue
        stem = fp.stem
        if stem.startswith("MEMBER-"):
            rest = stem[len("MEMBER-"):]
            org_m, _, rest2 = rest.partition("--")
            login, _, repo = rest2.partition("--")
            cand = REPOS / f"{org_m}-members" / login / (repo or rest2)
            repo_dir = cand if (cand / ".git").exists() else None
            owner, orgname = login, org_m
            repo = repo or rest2
        elif stem.startswith(("DIR-", "HIST-")):
            p = stem.split("--", 1)
            repo = p[1] if len(p) == 2 else stem
            orgname = stem.split("-", 1)[1].split("--", 1)[0]
            repo_dir = find_repo_dir(orgname, repo)
            owner = "org"
        else:
            continue  # SELF-- og andre ikke-org-rapporter
        if org and orgname.lower() != str(org).lower():
            continue
        if repo == "gists":
            kept = triage_findings(raw)
            for f in kept:
                f["_status"] = "LIVE"  # innhold hentet fra nåværende gist-revisjon
        elif repo_dir:
            kept = triage_findings(classify_findings(raw, orgname, repo, repo_dir))
        else:
            kept = triage_findings(raw)
        for f in kept:
            # _var for HIST-funn: hent fra nærmeste commit-linje (lazy, bare score>=2)
            if repo_dir and f.get("_status") not in ("LIVE", "SMELL") \
                    and "_var" not in f and not f.get("_smell"):
                f["_var"] = _hist_var(repo_dir, f)
            if repo_dir:
                # commit-timestamp stemples på funnet — aldersprediktoren
                # kan valideres mot faktiske utfall uten ny git-kall
                f["_repo_ts"] = _repo_last_commit_ts(repo_dir)
            yield orgname, owner, repo, repo_dir, f

_REPO_TS_CACHE = {}
def _repo_last_commit_ts(repo_dir):
    """Siste commit-timestamp for repoet (epoch). Repo-alder er den
    sterkeste prediktoren for om en lekning fortsatt er live —
    døde repoer er billigere å overse."""
    rd = str(repo_dir or "")
    if rd in _REPO_TS_CACHE:
        return _REPO_TS_CACHE[rd]
    ts = 0
    if rd:
        r = sh(["git", "-C", rd, "log", "-1", "--format=%ct"], timeout=10)
        try:
            ts = int((r.stdout or "").strip() or 0)
        except ValueError:
            ts = 0
    _REPO_TS_CACHE[rd] = ts
    return ts

def shortlist(org=None, want="high"):
    """Kun LIVE+<quality> funn — gruppert per fil, én rad per hemmelighet.
    Samme fil med to secrets = to rader (forskjellig blast radius/rotasjon)."""
    groups = {}
    for orgname, owner, repo, rd, f in iter_all_triaged(org):
        # UNK = transformert/pseudo-funn som ikke kan verifiseres mot HEAD
        # — vises med «?» som kandidater, ikke som bekreftet LIVE
        if f.get("_status") in ("LIVE", "UNK") and f.get("_quality") == want \
                and not f.get("_smell"):
            key = (orgname, owner, repo, _norm_file(f, rd))
            groups.setdefault(key, {"findings": [], "repo_dir": rd,
                                    "org": orgname, "owner": owner, "repo": repo})
            groups[key]["findings"].append(f)
    rows = sorted(groups.values(),
                  key=lambda g: (-max(x.get("_score", 0) for x in g["findings"]),
                                 g["org"], g["repo"]))
    total = sum(len(g["findings"]) for g in rows)
    # Samme secret i flere filer = ÉN credential, én rotasjon — lenk dem
    sid_locs = {}
    for g in rows:
        loc = f"{g['owner']}/{g['repo']}:{_norm_file(g['findings'][0], g['repo_dir'])[:60]}"
        for f in g["findings"]:
            sid = f.get("_sid") or ""
            if sid:
                sid_locs.setdefault(sid, []).append(loc)
    unk = sum(1 for g in rows for x in g["findings"]
              if x.get("_status") == "UNK")
    live = total - unk
    hdr = f"LIVE+{want}: {live} bekreftet" + (f" + {unk} ukjent(?)" if unk else "")
    print(f"{hdr} — {total} hemmeligheter i {len(rows)} filer")
    # Klynge rader som deler samme secret-id: én credential = én
    # undersøkelsesenhet, uansett hvor mange filer/repos den dukker opp i.
    # Union-find over rader via felles _sid.
    parent = list(range(len(rows)))
    def _find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]; x = parent[x]
        return x
    sid_first = {}
    for i, g in enumerate(rows):
        for f in g["findings"]:
            sid = f.get("_sid") or ""
            if not sid:
                continue
            if sid in sid_first:
                a, b = _find(i), _find(sid_first[sid])
                if a != b:
                    parent[a] = b
            else:
                sid_first[sid] = i
    clusters = {}
    for i, g in enumerate(rows):
        clusters.setdefault(_find(i), []).append(g)
    clist = sorted(clusters.values(),
                   key=lambda c: (-max(x.get("_score", 0)
                                       for g in c for x in g["findings"]),
                                  c[0]["org"], c[0]["repo"]))
    multi = sum(1 for c in clist if len(c) > 1)
    print(f"   {len(sid_first)} unike secrets -> {len(clist)} "
          f"undersøkelsesenheter ({multi} flerfil-klynger)")
    # Alder som *tier* (ikke gate): stale repoer (>STALE_DAYS) sorteres
    # under aktive og merkes [stale X.Xy], men er fortsatt i lista —
    # et dormant repo kan ha en levende nøkkel i fortsatt drift.
    now = time.time()
    def _cl_idle(c):
        ts = _repo_last_commit_ts(c[0].get("repo_dir"))
        return (now - ts) / 86400 if ts else 0
    clist.sort(key=lambda c: (_stale(_repo_last_commit_ts(
                              c[0].get("repo_dir"))),
                              -max(x.get("_score", 0)
                                   for g in c for x in g["findings"]),
                              c[0]["org"], c[0]["repo"]))
    fs_cache = {}
    for c in clist:
        # rep-rad = høyeste score i klyngen
        g = max(c, key=lambda gg: max(x.get("_score", 0)
                                      for x in gg["findings"]))
        orgname, owner, repo, rd = g["org"], g["owner"], g["repo"], g["repo_dir"]
        path = _norm_file(g["findings"][0], rd)[:75]
        fk = (str(rd), path)
        if fk not in fs_cache and rd:
            fs_cache[fk] = _first_seen(rd, path)
        seen_date, seen_hash = fs_cache.get(fk, ("", ""))
        meta = " ".join(x for x in (seen_date, seen_hash) if x)
        extra = f"  [+{len(c)-1} lokasjoner]" if len(c) > 1 else ""
        n_find = sum(len(gg["findings"]) for gg in c)
        cnt = f"  [{n_find} funn]" if n_find > 1 else ""
        idle = _cl_idle(c)
        stale_tag = f"  [stale {idle/365:.1f}y]" if _stale(
            _repo_last_commit_ts(c[0].get("repo_dir"))) else ""
        print(f"\n  {orgname} | {owner} | {repo} | {path}{extra}{cnt}{stale_tag}"
              + (f"  [{meta}]" if meta else ""))
        shown = 0
        for gg in sorted(c, key=lambda gg: -max(
                x.get("_score", 0) for x in gg["findings"])):
            if shown >= 15:
                print(f"   … +{len(c)-shown} flere lokasjoner")
                break
            shown += 1
            if len(c) > 1:
                print(f"   ↳ {gg['owner']}/{gg['repo']}:"
                      f"{_norm_file(gg['findings'][0], gg['repo_dir'])[:60]}")
            for f in sorted(gg["findings"], key=lambda x: -x.get("_score", 0)):
                line = f.get("StartLine") or "-"
                var = f.get("_var") or ""
                prefix = (f.get("Secret") or "")[:12]
                st = "?" if f.get("_status") == "UNK" else " "
                print(f"   {st}{f.get('_score')} {f.get('RuleID'):<22} "
                      f"L{line:<5} {var:<22} {prefix}…")
                sid = f.get("_sid") or ""
                others = [l for l in dict.fromkeys(sid_locs.get(sid, []))
                          if l != f"{gg['owner']}/{gg['repo']}:"
                          f"{_norm_file(f, gg['repo_dir'])[:60]}"]
                if others:
                    print(f"      ↳ også i: {', '.join(others[:4])}")

